    {
      "id": 16,
      "type": "logs",
      "title": "Sensitivity labels \u2014 which label, what it applies to",
      "description": "The metric counts labels by scope. This names each one, with its priority and description.\n\nNeeds a **Loki** datasource (selected above). Log attributes are Loki *structured metadata*, not stream labels: filter with `| event_name=\u2026` after `{service_name=\"graph2otel\"}`. A stream selector on an attribute matches zero rows silently (#90).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 65
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No rows. Either no Loki datasource is selected above, or nothing matched. Log attributes are structured metadata: filter with | attr=\u2026 after {service_name=\"graph2otel\"}, never {attr=\"\u2026\"}."
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"graph2otel\"} | event_name=`purview.sensitivity_label` | tenant_id=~\"$tenant\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "DLP policies by enforcement mode",
      "description": "\n\nNeeds a **Loki** datasource (selected above). Log attributes are Loki *structured metadata*, not stream labels: filter with `| event_name=\u2026` after `{service_name=\"graph2otel\"}`. A stream selector on an attribute matches zero rows silently (#90).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 75
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "noValue": "No rows. Either no Loki datasource is selected above, or nothing matched. Log attributes are structured metadata: filter with | attr=\u2026 after {service_name=\"graph2otel\"}, never {attr=\"\u2026\"}."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
