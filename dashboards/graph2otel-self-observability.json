        "h": 10,
        "w": 24,
        "x": 0,
        "y": 123
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No rows. Either no Loki datasource is selected above, or nothing matched. Log attributes are structured metadata: filter with | attr=\u2026 after {service_name=\"graph2otel\"}, never {attr=\"\u2026\"}."
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"graph2otel\"} | event_name=`graph2otel.blob_category` | tenant_id=~\"$tenant\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
