                "cardinality": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "per_metric_limit": {
                            "type": "integer"
                        },
                        "global_limit": {
                            "type": "integer"
                        }
                    }
                },
                "backfill": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "initial_lookback": {
                            "type": "string"
                        }
                    }
                },
                "checkpoint_dir": {
                    "type": "string"
                }
            }
