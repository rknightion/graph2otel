                            "exchange_online": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    }
                                }
                            },
                            "hunting": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                "otlp": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "protocol": {
                            "type": "string"
                        },
                        "endpoint": {
                            "type": "string"
                        },
                        "grafana_cloud": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "instance_id": {
                                    "type": "string"
                                },
                                "token": {
                                    "type": "string"
                                },
                                "token_file": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "collectors": {
                    "$ref": "#/definitions/collectorOverrides"
                },
