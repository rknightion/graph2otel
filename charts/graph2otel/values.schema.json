                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "addr": {
                            "type": "string"
                        },
                        "refresh_interval": {
                            "type": "string"
                        }
                    }
                },
                "profiling": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "pyroscope": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "server_address": {
                                    "type": "string"
                                },
                                "basic_auth_user": {
                                    "type": "string"
                                },
                                "basic_auth_password": {
                                    "type": "string"
                                },
                                "basic_auth_password_file": {
                                    "type": "string"
                                },
                                "tenant_id": {
                                    "type": "string"
                                },
                                "upload_rate": {
                                    "type": "string"
                                },
                                "tags": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "mutex_profile_fraction": {
                            "type": "integer"
                        },
                        "block_profile_rate": {
                            "type": "integer"
                        }
                    }
