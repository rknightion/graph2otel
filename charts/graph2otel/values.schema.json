                                }
                            }
                        },
                        "service_health": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "rollup": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "license": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "rollup": {
                                    "type": "boolean"
                                }
                            }
                        }
                            }
                        }
                    }
                },
