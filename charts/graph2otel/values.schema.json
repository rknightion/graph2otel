                        },
                        "max_per_minute": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "queue_size": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "rollup_interval": {
                            "type": "string"
                        },
                        "dedupe_retention": {
                            "type": "string"
                        },
                        "categories": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                        "config_posture": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "rollup": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "security_incident": {
