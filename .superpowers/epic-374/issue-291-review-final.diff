+func orderedPayloadPageFetcher(base time.Time, pageCount, payloadSize int, sentinel func()) PageFetcher {
+	page := 0
+	return pageFetcherFunc(func(_ context.Context, _ string) ([]map[string]any, string, error) {
+		page++
