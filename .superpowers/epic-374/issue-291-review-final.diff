+func measureOrderedRetainedHeap(
+	t *testing.T,
+	cfg EndpointConfig,
+	base time.Time,
+	pageCount,
+	payloadSize int,
+) int64 {
+	t.Helper()
+	runtime.GC()
+	var before runtime.MemStats
+	runtime.ReadMemStats(&before)
