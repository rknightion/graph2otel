{
  "Metrics": [
    {
      "Name": "defender.quarantine.held_messages.total",
      "Unit": "1",
      "Kind": "gauge",
      "Description": "Messages currently held in Microsoft Defender for Office 365 quarantine, by quarantine type, direction and entity type.",
      "AttrKeys": [
        "direction",
        "entity_type",
        "quarantine_type"
      ]
    },
    {
      "Name": "graph2otel.api.unexpected",
      "Unit": "1",
      "Kind": "sum",
      "Description": "Microsoft API responses that did not match what this collector was built against, by kind. Non-zero means an assumption needs re-checking; see the WARN log for the offending value.",
      "AttrKeys": [
        "collector",
        "field",
        "kind"
      ]
    }
  ],
  "Logs": [
    {
      "EventName": "defender.quarantine",
      "AttrKeys": [
        "direction",
        "entity_type",
        "expires",
        "ingest_transport",
        "internet_message_id",
        "network_message_id",
        "override_reason",
        "permission_to_allow_sender",
        "permission_to_block_sender",
        "permission_to_delete",
        "permission_to_download",
        "permission_to_preview",
        "permission_to_release",
        "permission_to_request_release",
        "permission_to_view_header",
        "policy_name",
        "policy_type",
        "quarantine_type",
        "received_time",
        "recipient_address",
        "recipient_count",
        "recipient_tag",
        "release_status",
        "released",
        "released_count",
        "reported",
        "sender_address",
        "size",
        "subject",
        "system_released",
        "tag_name"
      ]
    }
  ]
}
