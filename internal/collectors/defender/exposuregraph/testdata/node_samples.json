 {
  "NodeLabel": "mdcAuditingRecommendation",
  "NodeId": "bc82dee4a46c42958f06cecbc1333114",
  "NodeName": "log_disconnections should be set to 'on' for PostgreSQL Servers",
  "Categories@odata.type": "#Collection(String)",
  "Categories": [
   "auditing_finding",
   "finding"
  ],
  "EntityIds@odata.type": "#Collection(String)",
  "EntityIds": [
   "{\"type\":\"MdcAssessmentId\",\"id\":\"3d48c44b-31a0-45a9-9e21-c70eee41f4f6\"}"
  ],
  "NodeProperties": {
   "@odata.type": "#microsoft.graph.security.dynamicColumnValue",
   "rawData": {
    "@odata.type": "#microsoft.graph.security.dynamicColumnValue",
    "description": "<b>What is log_disconnections?</b><br><br>log_disconnections is a PostgreSQL parameter that logs when a client disconnects from the server, including session duration and resource usage.<br><br><b>Why is it a security concern?</b><br><br>If disabled, session termination events are not recorded, reducing visibility into suspicious short-lived sessions or brute-force attempts.<br><br><b>How could attackers exploit it or how could it lead to data breaches?</b><br><br>Attackers could connect and disconnect rapidly to probe the system without leaving traces, making detection harder.",
    "severity": "Medium",
    "recommendationCategory": "Unknown",
    "securityIssue": {
     "@odata.type": "#microsoft.graph.security.dynamicColumnValue",
     "type": "MdcRecommandationSecurityIssue",
     "securityIssue": "Auditing"
    }
   }
  }
 },
