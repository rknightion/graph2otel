{
  "Metrics": [
    {
      "Name": "defender.exposure_graph.edges",
      "Unit": "{edge}",
      "Kind": "gauge",
      "Description": "ExposureGraphEdges rows (pruned of bulk-inventory node labels), by edge label and whether the label was twinned.",
      "AttrKeys": [
        "edge_label",
        "twinned"
      ]
    },
    {
      "Name": "defender.exposure_graph.excluded_labels",
      "Unit": "{label}",
      "Kind": "gauge",
      "Description": "Node and edge labels excluded from twinning as bulk inventory (population over the twin threshold), by entity type.",
      "AttrKeys": [
        "entity_type"
      ]
    },
    {
      "Name": "defender.exposure_graph.nodes",
      "Unit": "{node}",
      "Kind": "gauge",
      "Description": "ExposureGraphNodes rows, by node label and whether the label was twinned.",
      "AttrKeys": [
        "node_label",
        "twinned"
      ]
    }
  ],
  "Logs": [
    {
      "EventName": "defender.exposure_graph_edge",
      "AttrKeys": [
        "delegated_permissions",
        "edge_id",
        "edge_label",
        "has_primary_refresh_token",
