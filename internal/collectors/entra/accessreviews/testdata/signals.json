{
  "Metrics": [
    {
      "Name": "entra.access_reviews.decisions",
      "Unit": "{decision}",
      "Kind": "gauge",
      "Description": "Entra access-review reviewer decisions, by decision and applied result. An instance whose decisions fetch failed contributes nothing this cycle, never a fabricated zero.",
      "AttrKeys": [
        "applied_result",
        "decision"
      ]
    },
    {
      "Name": "entra.access_reviews.instances",
      "Unit": "{instance}",
      "Kind": "gauge",
      "Description": "Entra access-review instances (recurrences), by instance status. A definition whose instances fetch failed is omitted this cycle, never counted as zero.",
      "AttrKeys": [
        "status"
      ]
    },
    {
      "Name": "entra.access_reviews.total",
      "Unit": "{review}",
      "Kind": "gauge",
      "Description": "Entra access-review definitions configured for the tenant, by review status.",
      "AttrKeys": [
        "status"
      ]
    },
    {
      "Name": "graph2otel.api.unexpected",
      "Unit": "1",
      "Kind": "sum",
      "Description": "Microsoft API responses that did not match what this collector was built against, by kind. Non-zero means an assumption needs re-checking; see the WARN log for the offending value.",
      "AttrKeys": [
        "collector",
        "field",
        "kind"
      ]
    }
  ],
  "Logs": [
    {
      "EventName": "entra.access_review",
      "AttrKeys": [
        "additional_notification_recipient_count",
        "apply_action_types",
        "auto_apply_decisions_enabled",
        "created_by",
        "created_by_id",
        "created_by_type",
        "created_by_user_principal_name",
        "created_date_time",
        "default_decision",
        "default_decision_enabled",
        "description_for_admins",
        "description_for_reviewers",
        "display_name",
        "fallback_reviewer_count",
        "id",
        "instance_duration_days",
        "justification_required_on_approval",
        "last_modified_date_time",
        "mail_notifications_enabled",
        "recommendations_enabled",
        "recurrence_interval",
        "recurrence_pattern_type",
        "recurrence_range_type",
        "recurrence_start_date",
        "reminder_notifications_enabled",
        "reviewer_count",
        "reviewer_queries",
        "scope_odata_type",
        "scope_principal_queries",
        "scope_query",
        "scope_resource_queries",
        "stage_count",
        "status"
      ]
    },
    {
      "EventName": "entra.access_review_decision",
      "AttrKeys": [
        "applied_result",
        "decision",
        "decision_id",
        "definition_id",
        "display_name",
        "instance_id",
        "last_user_sign_in_date_time",
        "principal_id",
        "principal_link",
        "principal_type",
        "recommendation",
        "resource_display_name",
        "resource_id",
        "resource_link",
        "resource_type",
        "user_principal_name"
      ]
    },
    {
      "EventName": "entra.access_review_instance",
      "AttrKeys": [
        "arrays_truncated",
        "definition_id",
        "end_date_time",
        "fallback_reviewer_count",
        "id",
        "reviewer_count",
        "reviewer_queries",
        "scope_odata_type",
        "scope_principal_queries",
        "scope_query",
        "scope_resource_queries",
        "start_date_time",
        "status"
      ]
    }
  ]
}
