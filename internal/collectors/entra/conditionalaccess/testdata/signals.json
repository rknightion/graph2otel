{
  "Metrics": [
    {
      "Name": "entra.ca.policies.total",
      "Unit": "{policy}",
      "Kind": "gauge",
      "Description": "Entra Conditional Access policies, by enforcement state.",
      "AttrKeys": [
        "state"
      ]
    },
    {
      "Name": "entra.named_locations.total",
      "Unit": "{location}",
      "Kind": "gauge",
      "Description": "Entra Conditional Access named locations, by type and trust.",
      "AttrKeys": [
        "is_trusted",
        "type"
      ]
    },
    {
      "Name": "graph2otel.api.unexpected",
      "Unit": "1",
      "Kind": "sum",
      "Description": "Microsoft API responses that did not match what this collector was built against, by kind. Non-zero means an assumption needs re-checking; see the WARN log for the offending value.",
      "AttrKeys": [
        "collector",
        "field",
        "kind"
      ]
    }
  ],
  "Logs": [
    {
      "EventName": "entra.conditional_access_policy",
      "AttrKeys": [
        "authentication_strength_display_name",
        "built_in_controls",
        "client_app_types",
        "created_date_time",
        "display_name",
        "exclude_groups",
        "exclude_locations",
        "exclude_roles",
        "exclude_users",
        "grant_controls_operator",
        "has_grant_controls",
        "has_session_controls",
        "id",
        "include_locations",
        "include_roles",
        "include_users",
        "last_modified_date_time",
        "sign_in_risk_levels",
        "state",
        "template_id"
      ]
    },
    {
      "EventName": "entra.named_location",
      "AttrKeys": [
        "countries",
        "country_lookup_method",
        "created_date_time",
        "display_name",
        "id",
        "include_unknown_countries_and_regions",
        "ipv4_cidr_ranges",
        "ipv6_cidr_ranges",
        "is_trusted",
        "last_modified_date_time",
        "type"
      ]
    }
  ]
}
