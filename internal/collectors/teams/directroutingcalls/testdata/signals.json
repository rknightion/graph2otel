{
  "Metrics": [
    {
      "Name": "graph2otel.api.unexpected",
      "Unit": "1",
      "Kind": "sum",
      "Description": "Microsoft API responses that did not match what this collector was built against, by kind. Non-zero means an assumption needs re-checking; see the WARN log for the offending value.",
      "AttrKeys": [
        "collector",
        "field",
        "kind"
      ]
    },
    {
      "Name": "teams.direct_routing.calls",
      "Unit": "{call}",
      "Kind": "sum",
      "Description": "New Teams Direct Routing attempts",
      "AttrKeys": [
        "outcome",
        "sip_class",
        "trunk_fqdn"
      ]
    },
    {
      "Name": "teams.direct_routing.network_effectiveness_ratio",
      "Unit": "1",
      "Kind": "gauge",
      "Description": "Fraction of new Teams Direct Routing attempts that answered or reached a busy user, in the latest successful poll",
      "AttrKeys": [
        "trunk_fqdn"
      ]
    }
  ],
  "Logs": [
    {
      "EventName": "teams.direct_routing_call",
      "AttrKeys": [
        "call_end_sub_reason",
        "call_type",
        "callee_number",
        "caller_number",
        "correlation_id",
        "duration_seconds",
        "end_time",
        "failure_time",
        "final_sip_code",
        "final_sip_code_phrase",
        "id",
        "ingest_transport",
        "invite_time",
        "media_bypass_enabled",
        "media_path_location",
        "signaling_location",
        "start_time",
        "successful_call",
        "trunk_fqdn",
        "user_display_name",
        "user_id",
        "user_principal_name"
      ]
    },
    {
      "EventName": "teams.direct_routing_poll",
      "AttrKeys": [
        "effective_attempts",
        "poll_attempts",
        "source_success_sip_4xx",
        "trunk_fqdn"
      ]
    }
  ]
}
