/* ─────────────────────────────────────────────────────────────────────────────
   m7kni Design System v2 - 2otel console family token block.
   SHARED VERBATIM across tailscale2otel, opnsense2otel, graph2otel,
   codexlb2otel. Do not edit in one repo only. Generated from
   packages/tokens (DTCG) - hex values are the resolved sRGB of the oklch
   sources noted per line.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  /* Type */
  --t2o-sans:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --t2o-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --t2o-fs-2xs:10px;   /* uppercase micro labels */
  --t2o-fs-xs:11px;    /* mono sub-values, notes, badges */
  --t2o-fs-sm:12.5px;  /* table cells, controls, machine text */
  --t2o-fs-md:13.5px;  /* body copy */
  --t2o-fs-lg:15px;    /* page title, card values */
  --t2o-fs-xl:18px;    /* posture values */
  --t2o-fs-2xl:24px;   /* rare, one per page at most */
  --t2o-fw-regular:400;
  --t2o-fw-medium:500;
  --t2o-fw-semibold:600;
  --t2o-tracking-label:0.13em;

  /* Space and shape */
  --t2o-space-1:4px;  --t2o-space-2:8px;  --t2o-space-3:12px;
  --t2o-space-4:16px; --t2o-space-5:20px; --t2o-space-6:24px;
  --t2o-radius-control:3px;    /* buttons, inputs, chips, badges */
  --t2o-radius-container:0px;  /* panels, cards, tables - square */
  --t2o-radius-overlay:6px;    /* tooltips, popovers */
  --t2o-row:36px;              /* table row height */
  --t2o-dur-fast:120ms; --t2o-dur-base:160ms;

  /* Light theme - the default */
  --t2o-bg:#eef3f6;            /* oklch(0.962 0.007 227) */
  --t2o-surface:#f6fafb;       /* oklch(0.982 0.004 227) */
  --t2o-raised:#ffffff;        /* oklch(1 0 0) - table headers, inputs */
  --t2o-hover:#e7eef1;         /* oklch(0.945 0.009 227) */
  --t2o-selected:#dee8ec;      /* oklch(0.925 0.012 227) */
  --t2o-track:#c7cfd3;         /* oklch(0.85 0.01 227) - bar troughs */
  --t2o-fg:#192124;            /* oklch(0.24 0.012 227) */
  --t2o-fg-soft:#384146;       /* oklch(0.37 0.015 227) */
  --t2o-fg-muted:#59666b;      /* oklch(0.5 0.018 227) */
  --t2o-fg-faint:#869196;      /* oklch(0.65 0.015 227) - placeholder/disabled ONLY */
  --t2o-accent:#1d6a8a;        /* petrol */
  --t2o-accent-hover:#175874;
  --t2o-accent-soft:#e4eef4;   /* banner and selected-row wash */
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2;          /* oklch(0.9 0.008 227) */
  --t2o-line-strong:#bec5c9;   /* oklch(0.82 0.01 227) */
  --t2o-ok:#2f7d4f;
  --t2o-warn:#8f6410;
  --t2o-fail:#a83a2e;

  /* Direction pair - see section 7 */
  --t2o-tx:var(--t2o-accent);
  --t2o-rx:var(--t2o-fg);
}

/* No stored preference: follow the OS. Explicit data-theme always wins. */
@media (prefers-color-scheme: dark){
  :root:not([data-theme]){
    --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
    --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
    --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
    --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
    --t2o-on-accent:#0e161b;
    --t2o-line:#2a3235; --t2o-line-strong:#40494e;
    --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
  }
}
:root[data-theme="light"]{
  --t2o-bg:#eef3f6; --t2o-surface:#f6fafb; --t2o-raised:#ffffff;
  --t2o-hover:#e7eef1; --t2o-selected:#dee8ec; --t2o-track:#c7cfd3;
  --t2o-fg:#192124; --t2o-fg-soft:#384146; --t2o-fg-muted:#59666b; --t2o-fg-faint:#869196;
  --t2o-accent:#1d6a8a; --t2o-accent-hover:#175874; --t2o-accent-soft:#e4eef4;
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2; --t2o-line-strong:#bec5c9;
  --t2o-ok:#2f7d4f; --t2o-warn:#8f6410; --t2o-fail:#a83a2e;
}
:root[data-theme="dark"]{
  --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
  --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
  --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
  --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
  --t2o-on-accent:#0e161b;
  --t2o-line:#2a3235; --t2o-line-strong:#40494e;
  --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
}

/* ── Compatibility aliases ───────────────────────────────────────────────────
   The three templates already reference --bg/--panel/--line/... in hundreds of
   places, including inside JS that writes `fill:"var(--rx)"` into SVG. Keeping
   these aliases means the restyle lands as a palette swap plus targeted
   per-page edits, not a rename sweep. New CSS should use the --t2o-* names.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  --bg:var(--t2o-bg);
  --panel:var(--t2o-surface);
  --panel2:var(--t2o-raised);
  --line:var(--t2o-line);
  --fg:var(--t2o-fg);
  --muted:var(--t2o-fg-muted);
  --accent:var(--t2o-accent);
  --ok:var(--t2o-ok);
  --warn:var(--t2o-warn);
  --err:var(--t2o-fail);
  --pending:var(--t2o-fg-muted);
  --grid:var(--t2o-line);
  --tx:var(--t2o-tx);
  --rx:var(--t2o-rx);
  --mono:var(--t2o-mono);
}
@font-face{
  font-family:"Hanken Grotesk";font-style:normal;font-weight:100 900;font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin.woff2") format("woff2");
  unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face{
  font-family:"Hanken Grotesk";font-style:normal;font-weight:100 900;font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin-ext.woff2") format("woff2");
  unicode-range:U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20CF,U+2113,U+2C60-2C7F,U+A720-A7FF;
}
@font-face{
  font-family:"JetBrains Mono";font-style:normal;font-weight:100 800;font-display:swap;
  src:url("/_static/fonts/JetBrainsMono-Variable.woff2") format("woff2");
}
/* Family extensions recorded in design/console-v2/implementation-spec.md section 12
   (small-chart standard, row marker). They sit AFTER the verbatim token block so
   that block stays byte-identical across the four consoles. */
:root{
  --t2o-chart-grid:var(--t2o-line);
  --t2o-chart-axis:var(--t2o-fg-muted);
  --t2o-series-1:var(--t2o-accent);
  --t2o-series-2:var(--t2o-fg);
  --t2o-series-3:var(--t2o-warn);
  --t2o-chart-area:0.10;
  --t2o-chart-h:110px;
  --t2o-chart-h-tall:150px;
  --t2o-spark-w:100px;
  --t2o-spark-h:22px;
  --t2o-row-marker:2px;
  --g2o-nav-h:40px;
}
:root[data-theme="light"]{color-scheme:light}
:root[data-theme="dark"]{color-scheme:dark}
@media (prefers-color-scheme: dark){:root:not([data-theme]){color-scheme:dark}}
.t2o-row--alert>td:first-child{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-fail)}
.t2o-row--note>td:first-child{box-shadow:inset var(--t2o-row-marker) 0 0 var(--t2o-accent)}

  *{box-sizing:border-box}
  body{margin:0;background:var(--t2o-bg);color:var(--t2o-fg-soft);font:var(--t2o-fw-regular) var(--t2o-fs-md)/1.5 var(--t2o-sans)}
  a{color:var(--t2o-accent);text-decoration:none} a:hover{text-decoration:underline;color:var(--t2o-accent-hover)}
  code{font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm);color:var(--t2o-fg)}
  svg.gl{width:11px;height:11px;flex:none;display:inline-block;vertical-align:-1px}
  header{padding:12px 20px;border-bottom:1px solid var(--t2o-line);background:var(--t2o-surface);display:flex;align-items:center;gap:var(--t2o-space-3);flex-wrap:wrap}
  header h1{margin:0;font-size:var(--t2o-fs-lg);font-weight:var(--t2o-fw-semibold);color:var(--t2o-fg)}
  header .ver{color:var(--t2o-fg-muted);font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs)}
  header .spacer{flex:1}
  main{max-width:1180px;margin:0 auto;padding:20px 24px 60px}
  /* Collectors breaks out of the centered column to ~90% of the viewport. */
  .wide{width:92vw;max-width:92vw;margin-left:calc(50% - 46vw)}
  section{margin:0 0 26px}
  .sub-h{font-size:var(--t2o-fs-2xs);text-transform:uppercase;letter-spacing:var(--t2o-tracking-label);color:var(--t2o-fg-muted);margin:26px 0 10px;font-weight:var(--t2o-fw-semibold)}
  .sub-h .tsum{text-transform:none;letter-spacing:0;font-weight:var(--t2o-fw-regular);font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);margin-left:8px}
  .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--t2o-space-3)}
  .cards.c2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .card{background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);padding:10px 12px;min-width:0}
  .card .k{color:var(--t2o-fg-muted);font-size:var(--t2o-fs-2xs);text-transform:uppercase;letter-spacing:var(--t2o-tracking-label);font-weight:var(--t2o-fw-semibold);margin-bottom:6px}
  .card .v{font-family:var(--t2o-mono);font-size:var(--t2o-fs-lg);font-weight:var(--t2o-fw-medium);color:var(--t2o-fg);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  .card .sub{color:var(--t2o-fg-muted);font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);margin-top:4px;overflow-wrap:anywhere}
  .card .sub[hidden]{display:none}
  /* State words always carry a glyph; colour is never the only signal. */
  .badge{display:inline-flex;align-items:center;gap:5px;font-family:var(--t2o-sans);font-size:var(--t2o-fs-xs);font-weight:var(--t2o-fw-semibold);letter-spacing:.06em;text-transform:uppercase;line-height:1.4;color:var(--t2o-fg-muted)}
  .badge.ok{color:var(--t2o-ok)} .badge.err{color:var(--t2o-fail)} .badge.warn{color:var(--t2o-warn)}
  .badge.info{color:var(--t2o-fg-soft)} .badge.muted,.badge.pending{color:var(--t2o-fg-muted)}
  .badge[data-state="healthy_empty"]{color:var(--t2o-fg-muted)}
  .badge.chip{border:1px solid currentColor;border-radius:var(--t2o-radius-control);padding:2px 8px}
  .badge.chip.pending{border-style:dashed}
  .chip{display:inline-block;border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);padding:1px 7px;font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);color:var(--t2o-fg-soft)}
  .overdue{color:var(--t2o-warn);font-weight:var(--t2o-fw-semibold)}
  table{width:100%;border-collapse:collapse;background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);margin-top:8px}
  th{position:sticky;top:var(--g2o-nav-h);z-index:1;background:var(--t2o-raised);border-bottom:1px solid var(--t2o-line-strong);padding:7px 12px;text-align:left;font-family:var(--t2o-sans);font-size:var(--t2o-fs-2xs);font-weight:var(--t2o-fw-semibold);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted);white-space:nowrap}
  td{padding:8px 12px;min-height:var(--t2o-row);height:var(--t2o-row);vertical-align:top;border-bottom:1px solid var(--t2o-line);font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm);font-variant-numeric:tabular-nums;color:var(--t2o-fg)}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover{background:var(--t2o-raised)}
  th.num,td.num{text-align:right;white-space:nowrap}
  td .sub{display:block;font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted);margin-top:1px;overflow-wrap:anywhere}
  td.sans{font-family:var(--t2o-sans)}
  table.rl{max-width:700px}
  .mono{font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm);overflow-wrap:anywhere} .muted{color:var(--t2o-fg-muted)}
  p.muted{font-size:var(--t2o-fs-md);color:var(--t2o-fg-soft);max-width:760px}
  .cursor{display:block;font-size:10.5px;margin-top:3px;color:var(--t2o-fg-muted)} .cursor code{background:transparent;padding:0;font-size:inherit;color:inherit}
  td.err{max-width:300px;overflow-wrap:anywhere;font-size:var(--t2o-fs-xs);color:var(--t2o-fail)}
  td.err .muted{color:var(--t2o-fg-muted)}
  /* Headroom colour ramp: the sparkline takes its row's state colour. */
  .hr-ok{color:var(--t2o-ok)} .hr-warn{color:var(--t2o-warn)} .hr-err{color:var(--t2o-fail)}
  svg.spark{width:var(--t2o-spark-w);height:var(--t2o-spark-h);vertical-align:middle;display:inline-block;fill:none;stroke:var(--t2o-series-1);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round}
  svg.spark polyline{vector-effect:non-scaling-stroke}
  .hr-ok svg.spark,.hr-warn svg.spark,.hr-err svg.spark{stroke:currentColor}
  .outcome{display:inline-flex;gap:2px;align-items:center;margin-left:8px;vertical-align:middle}
  .outcome i{width:4px;height:13px;border-radius:var(--t2o-radius-container);background:var(--t2o-ok);display:inline-block} .outcome i.f{background:var(--t2o-fail)}
  td.recent{white-space:nowrap}
  .ocount{margin-left:6px;font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted)}
  /* Small-chart standard (family spec section 12.1): value labels sit in the 44px gutter, outside the plot. */
  .legend{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:8px;min-height:16px;font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);color:var(--t2o-fg-soft)}
  .legend .lg{display:inline-flex;align-items:center;gap:6px}
  .legend svg{width:14px;height:6px;overflow:visible}
  .chart-wrap{position:relative;height:var(--t2o-chart-h);margin-top:4px}
  svg.chart{width:100%;height:100%;display:block;overflow:visible}
  svg.chart .grid{stroke:var(--t2o-chart-grid);stroke-width:1}
  svg.chart .ax{fill:var(--t2o-chart-axis);font-family:var(--t2o-mono);font-size:9px}
  svg.chart .note{fill:var(--t2o-fg-muted);font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs)}
  svg.chart .noteic{color:var(--t2o-fg-muted)}
  svg.chart .cross{stroke:var(--t2o-fg-muted);stroke-width:1;stroke-dasharray:2 2}
  svg.chart .dot{fill:var(--t2o-series-1)}
  svg.chart .area{fill:var(--t2o-series-1);opacity:var(--t2o-chart-area)}
  svg.chart .ln,.legend .ln{fill:none;stroke-linejoin:round}
  .s1{stroke:var(--t2o-series-1);stroke-width:1.5}
  .s2{stroke:var(--t2o-series-2);stroke-width:1.5;stroke-dasharray:4 3}
  .s3{stroke:var(--t2o-series-3);stroke-width:1.6;stroke-dasharray:1 3}
  .chart-tip{position:absolute;pointer-events:none;display:none;background:var(--t2o-raised);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-overlay);padding:4px 8px;font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);color:var(--t2o-fg);white-space:nowrap;transform:translate(-50%,-115%);z-index:2}
  /* Posture strip */
  .rollup{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);margin-bottom:18px}
  .rollup .rc{display:flex;flex-direction:column-reverse;gap:2px;padding:10px 14px;border-left:1px solid var(--t2o-line);min-width:0}
  .rollup .rc:first-child{border-left:0}
  .rollup .rc .rv{font-family:var(--t2o-mono);font-size:var(--t2o-fs-xl);font-weight:var(--t2o-fw-medium);font-variant-numeric:tabular-nums;color:var(--t2o-fg);overflow-wrap:anywhere}
  .rollup .rc .rv.ok{color:var(--t2o-ok)} .rollup .rc .rv.err{color:var(--t2o-fail)} .rollup .rc .rv.warn{color:var(--t2o-warn)} .rollup .rc .rv.pending{color:var(--t2o-fg-muted)}
  .rollup .rc .rk{color:var(--t2o-fg-muted);font-size:var(--t2o-fs-2xs);text-transform:uppercase;letter-spacing:var(--t2o-tracking-label);font-weight:var(--t2o-fw-semibold)}
  /* Filter control with match count */
  .filterbar{display:flex;align-items:center;gap:10px;margin:10px 0}
  .filterwrap{position:relative;width:100%;max-width:340px}
  .filterwrap svg{position:absolute;left:9px;top:50%;width:13px;height:13px;transform:translateY(-50%);color:var(--t2o-fg-muted);pointer-events:none}
  .filter{width:100%;padding:6px 11px 6px 30px;background:var(--t2o-raised);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);color:var(--t2o-fg);font:var(--t2o-fs-sm) var(--t2o-sans)}
  .filter::placeholder{color:var(--t2o-fg-faint)}
  #filterCount{font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted)}
  .legendtab{margin-top:14px;display:flex;flex-wrap:wrap;gap:6px 18px;font-size:var(--t2o-fs-xs);color:var(--t2o-fg-muted)}
  .legendtab span{display:inline-flex;align-items:center;gap:6px}
  .legendtab .gl{width:11px;height:11px}
  /* Header banners */
  .reasons{display:flex;align-items:flex-start;gap:8px;padding:6px 20px;background:var(--t2o-accent-soft);color:var(--t2o-fg-soft);font-size:var(--t2o-fs-xs);font-family:var(--t2o-mono);border-bottom:1px solid var(--t2o-line)}
  .reasons svg{width:13px;height:13px;flex:none;margin-top:1px;color:var(--t2o-fail)}
  .reasons .badge{margin-right:4px}
  .reasons[hidden]{display:none}
  #staleBanner{display:none;align-items:center;gap:8px;padding:8px 20px;background:var(--t2o-surface);color:var(--t2o-fg-soft);font-size:var(--t2o-fs-sm);border-bottom:1px solid var(--t2o-line)}
  #staleBanner svg{width:13px;height:13px;color:var(--t2o-warn);flex:none}
  #staleBanner.show{display:flex}
  #staleBanner button{margin-left:auto}
  .controls{display:inline-flex;gap:10px;align-items:center}
  button.ctl{display:inline-flex;align-items:center;gap:6px;background:var(--t2o-raised);color:var(--t2o-fg);border:1px solid var(--t2o-line-strong);border-radius:var(--t2o-radius-control);padding:3px 10px;min-height:26px;font:var(--t2o-fw-medium) var(--t2o-fs-xs) var(--t2o-mono);cursor:pointer}
  button.ctl:hover{background:var(--t2o-hover)}
  button.ctl svg{width:14px;height:14px}
  button.ctl:focus-visible,.tab-btn:focus-visible,.filter:focus-visible,a:focus-visible{outline:2px solid var(--t2o-accent);outline-offset:1px}
  footer{max-width:1180px;margin:0 auto;padding:0 24px 40px;color:var(--t2o-fg-muted);font-family:var(--t2o-mono);font-size:var(--t2o-fs-xs)}
  /* Underline tabs */
  nav.tabs{position:sticky;top:0;z-index:5;display:flex;align-items:stretch;gap:0;padding:0 20px;height:var(--g2o-nav-h);overflow-x:auto;background:var(--t2o-bg);border-bottom:1px solid var(--t2o-line)}
  .tab-btn{display:inline-flex;align-items:center;gap:6px;background:transparent;color:var(--t2o-fg-muted);border:0;border-bottom:2px solid transparent;padding:9px 12px;font:var(--t2o-fw-medium) var(--t2o-fs-sm) var(--t2o-sans);cursor:pointer;white-space:nowrap}
  .tab-btn:hover{color:var(--t2o-fg)} .tab-btn.active{color:var(--t2o-fg);font-weight:var(--t2o-fw-semibold);border-bottom-color:var(--t2o-accent)}
  .tabcount{display:inline-flex;align-items:center;gap:4px;font-family:var(--t2o-mono);font-size:var(--t2o-fs-2xs);color:var(--t2o-fail)}
  .tabcount svg{width:8px;height:8px}
  .tabcount[hidden]{display:none}
  section[data-tab]{display:none} section[data-tab].active{display:block}
  /* Config: read-only key / value rows, mono dominant */
  .kv{background:var(--t2o-surface);border:1px solid var(--t2o-line);border-radius:var(--t2o-radius-container);max-width:900px}
  .kvr{display:grid;grid-template-columns:220px minmax(0,1fr);gap:12px;padding:8px 12px;border-bottom:1px solid var(--t2o-line);font-family:var(--t2o-mono);font-size:var(--t2o-fs-sm)}
  .kvr:last-child{border-bottom:0}
  .kvr .kk{color:var(--t2o-fg-muted)} .kvr .kvv{color:var(--t2o-fg);overflow-wrap:anywhere}
  @media (max-width:820px){
    .cards,.cards.c2{grid-template-columns:minmax(0,1fr)}
    .rollup{grid-auto-flow:row;grid-template-columns:repeat(2,minmax(0,1fr))}
    .rollup .rc:nth-child(odd){border-left:0}
    .kvr{grid-template-columns:minmax(0,1fr)}
  }
  @media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}
</style>
<script>(function(){try{var t=localStorage.getItem('graph2otel-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<script>window.__refreshMs = {{if .RefreshMs}}{{.RefreshMs}}{{else}}5000{{end}};</script>
<noscript><style>section[data-tab]{display:block!important;margin-bottom:34px} nav.tabs{display:none}</style></noscript>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
<symbol id="i-warning" viewBox="0 0 256 256" fill="currentColor"><path d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"/></symbol>
<symbol id="i-warning-circle" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-8-80V80a8,8,0,0,1,16,0v56a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,172Z"/></symbol>
<symbol id="i-info" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></symbol>
<symbol id="i-prohibit" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm88,104a87.56,87.56,0,0,1-20.41,56.28L71.72,60.4A88,88,0,0,1,216,128ZM40,128A87.56,87.56,0,0,1,60.41,71.72L184.28,195.6A88,88,0,0,1,40,128Z"/></symbol>
<symbol id="i-arrows-split" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,189.66l-32,32a8,8,0,0,1-11.32,0l-32-32a8,8,0,0,1,11.32-11.32L184,196.69V139.31l-56-56-56,56v57.38l18.34-18.35a8,8,0,0,1,11.32,11.32l-32,32a8,8,0,0,1-11.32,0l-32-32a8,8,0,0,1,11.32-11.32L56,196.69V136a8,8,0,0,1,2.34-5.66L120,68.69V24a8,8,0,0,1,16,0V68.69l61.66,61.65A8,8,0,0,1,200,136v60.69l18.34-18.35a8,8,0,0,1,11.32,11.32Z"/></symbol>
<symbol id="i-magnifying-glass" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"/></symbol>
<symbol id="i-circle-half" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm8,16.37a86.4,86.4,0,0,1,16,3V212.67a86.4,86.4,0,0,1-16,3Zm32,9.26a87.81,87.81,0,0,1,16,10.54V195.83a87.81,87.81,0,0,1-16,10.54ZM40,128a88.11,88.11,0,0,1,80-87.63V215.63A88.11,88.11,0,0,1,40,128Zm160,50.54V77.46a87.82,87.82,0,0,1,0,101.08Z"/></symbol>
<symbol id="s-circle" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7" fill="currentColor"/></symbol>
<symbol id="s-diamond" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0.5 15.5 8 8 15.5 0.5 8Z" fill="currentColor"/></symbol>
<symbol id="s-ring" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
</defs></svg>
<header>
  <h1>graph2otel</h1>
  <span class="ver">{{.Service.Version}} &middot; {{.Service.GoVersion}}</span>
  <span class="ver">up {{.Service.Uptime}} &middot; started {{.Service.StartedAt}}</span>
  <span class="spacer"></span>
  <button class="ctl" id="themeToggle" title="Toggle light/dark theme" aria-label="Toggle theme"><svg aria-hidden="true"><use href="#i-circle-half"/></svg></button>
  <span class="badge chip {{healthClass .Health}}" id="healthBadge" title="{{range .HealthReasons}}{{.}}&#10;{{end}}">{{shapeFor (healthClass .Health)}}{{.Health}}</span>
  <span class="badge chip {{if .Readiness.Ready}}ok{{else}}err{{end}}" id="readinessBadge" title="{{.Readiness.Reason}}">{{if .Readiness.Ready}}{{shapeFor "ok"}}{{else}}{{shapeFor "err"}}{{end}}{{.Readiness.State}}</span>
</header>
<div class="reasons" id="healthReasons"{{if not .HealthReasons}} hidden{{end}}><svg aria-hidden="true"><use href="#i-warning-circle"/></svg><span id="healthReasonsText">{{range $i, $r := .HealthReasons}}{{if $i}} &middot; {{end}}{{$r}}{{end}}</span></div>
<div id="staleBanner"><svg aria-hidden="true"><use href="#i-warning"/></svg><span id="staleMsg"></span><button class="ctl" id="retryNow" type="button">Retry now</button></div>
<nav class="tabs" id="tabs" role="tablist" aria-label="Console sections">
  <button class="tab-btn" id="tab-overview" role="tab" data-target="overview" aria-controls="panel-overview">Overview</button>
  <button class="tab-btn" id="tab-collectors" role="tab" data-target="collectors" aria-controls="panel-collectors">Collectors<span class="tabcount" id="tabFailing"{{if not .Fleet.Failing}} hidden{{end}} title="failing collectors">{{shapeFor "err"}}<span id="tabFailingN">{{.Fleet.Failing}}</span></span></button>
  <button class="tab-btn" id="tab-config" role="tab" data-target="config" aria-controls="panel-config">Config</button>
  <button class="tab-btn" id="tab-cardinality" role="tab" data-target="cardinality" aria-controls="panel-cardinality">Cardinality{{if .Cardinality.Offenders}}<span class="tabcount" id="tabOffenders" title="high-cardinality offenders">{{shapeFor "err"}}{{len .Cardinality.Offenders}}</span>{{end}}</button>
</nav>
<main>

  <!-- ═══ OVERVIEW ═══ -->
  <section data-tab="overview" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview">
    <div class="rollup" id="rollup">
      <div class="rc"><span class="rv {{healthClass .Health}}" id="ruHealth">{{.Health}}</span><span class="rk">health</span></div>
      <div class="rc"><span class="rv {{if .Readiness.Ready}}ok{{else}}err{{end}}" id="ruReadiness">{{.Readiness.State}}</span><span class="rk">readiness</span></div>
      <div class="rc"><span class="rv" id="ruTenants">{{len .Tenants}}</span><span class="rk">tenants</span></div>
      <div class="rc"><span class="rv" id="ruEnabled">—</span><span class="rk">collectors</span></div>
      <div class="rc"><span class="rv" id="ruFailing">—</span><span class="rk">failing</span></div>
      <div class="rc"><span class="rv" id="ruPending">—</span><span class="rk">starting</span></div>
    </div>

    <!-- Throttle headroom lives at the TOP of the page (#206). -->
    <div class="sub-h">Throttle headroom</div>
    <div id="throttle">
    {{range .Tenants}}{{if .RateLimits}}
      <div class="sub-h" style="margin:14px 0 4px">Tenant <code>{{.TenantID}}</code></div>
      <table class="rl">
        <thead><tr><th>Workload</th><th class="num">limit/s</th><th class="num">burst</th><th class="num">tokens</th><th class="num">headroom</th><th>trend</th></tr></thead>
        <tbody>
        {{range .RateLimits}}
          <tr><td><code>{{.Workload}}</code></td><td class="num">{{printf "%.3g" .LimitPerSec}}</td><td class="num">{{.Burst}}</td><td class="num">{{printf "%.1f" .Tokens}}</td><td class="num hr-{{headroomClass .HeadroomPct}}">{{printf "%.0f" .HeadroomPct}}%</td><td class="hr-{{headroomClass .HeadroomPct}}">{{sparklineF .HeadroomSeries}}</td></tr>
        {{end}}
        </tbody>
      </table>
    {{end}}{{else}}{{end}}
    </div>

    <div class="sub-h">Service</div>
    <div class="cards">
      <div class="card"><div class="k">Version</div><div class="v">{{.Service.Version}}</div><div class="sub">{{.Service.GoVersion}}</div></div>
      <div class="card"><div class="k">Uptime</div><div class="v" id="uptime">{{.Service.Uptime}}</div><div class="sub">since {{.Service.StartedAt}}</div></div>
      <div class="card"><div class="k">Tenants</div><div class="v">{{len .Tenants}}</div></div>
    </div>

    <!-- Runtime, throughput and fleet trends (#227). Every value is
         server-rendered first so the page is meaningful before the first poll,
         then updated in place by refresh(). -->
    <div class="sub-h">Runtime trend (~10 min)</div>
    <div class="cards">
      <div class="card"><div class="k">Goroutines</div><div class="v" id="goroutines">{{.Runtime.Goroutines}}</div><div class="sub">GOMAXPROCS <span id="gomaxprocs">{{.Runtime.GOMAXPROCS}}</span></div>
        <div class="legend" id="lgGoroutines"></div><div class="chart-wrap"><svg class="chart" id="chGoroutines"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Heap in use</div><div class="v" id="heapAlloc">{{.Runtime.HeapAlloc}}</div><div class="sub">GC cycles <span id="numGC">{{.Runtime.NumGC}}</span></div>
        <div class="legend" id="lgHeap"></div><div class="chart-wrap"><svg class="chart" id="chHeap"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">GC rate</div><div class="v" id="gcRate">&mdash;</div><div class="sub">cycles/sec</div>
        <div class="legend" id="lgGC"></div><div class="chart-wrap"><svg class="chart" id="chGC"></svg><div class="chart-tip"></div></div></div>
    </div>

    <div class="sub-h">Throughput &amp; fleet trend (~10 min)</div>
    <div class="cards c2">
      <div class="card"><div class="k">Emitted to SDK</div><div class="v" id="metricRate">{{printf "%.1f" .Throughput.MetricPointsPerSec}}</div><div class="sub">metric points/sec &middot; <span id="logRate">{{printf "%.1f" .Throughput.LogRecordsPerSec}}</span> log records/sec</div>
        <div class="legend" id="lgEmit"></div><div class="chart-wrap"><svg class="chart" id="chEmit"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Active series</div><div class="v" id="activeSeries">{{.SeriesTrend.TotalSeries}}</div><div class="sub">distinct series last export</div>
        <div class="legend" id="lgCard"></div><div class="chart-wrap"><svg class="chart" id="chCard"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Collectors failing</div><div class="v" id="fleetFailing">{{.Fleet.Failing}}</div><div class="sub"><span id="fleetEnabled">{{.Fleet.Enabled}}</span> active &middot; <span id="fleetPending">{{.Fleet.Pending}}</span> starting</div>
        <div class="legend" id="lgFailing"></div><div class="chart-wrap"><svg class="chart" id="chFailing"></svg><div class="chart-tip"></div></div></div>
      <div class="card"><div class="k">Mean run duration</div><div class="v" id="meanDuration">{{printf "%.0f" .Fleet.MeanDurationMs}}ms</div><div class="sub">across every collector</div>
        <div class="legend" id="lgDuration"></div><div class="chart-wrap"><svg class="chart" id="chDuration"></svg><div class="chart-tip"></div></div></div>
    </div>

    {{with .Delivery}}
    <div class="sub-h">Exporter accepted</div>
    <div class="cards c2" id="deliveryStatus">
      <div class="card">
        <div class="k">Metrics</div>
        <div class="v"><span class="badge {{healthClass (printf "%s" .Metrics.State)}}" id="metricDeliveryState">{{shapeFor (healthClass (printf "%s" .Metrics.State))}}{{.Metrics.State}}</span></div>
        <div class="sub"><span id="metricDeliveryAttempts">{{.Metrics.ExportAttempts}}</span> attempts &middot; <span id="metricDeliverySuccesses">{{.Metrics.ExportSuccesses}}</span> accepted &middot; <span id="metricDeliveryFailures">{{.Metrics.ExportFailures}}</span> failed</div>
        <div class="sub" id="metricDeliveryFlushLine"{{if and (eq .Metrics.ForceFlushFailures 0) (eq .Metrics.ShutdownFailures 0)}} hidden{{end}}>flush failures <span id="metricDeliveryFlushFailures">{{.Metrics.ForceFlushFailures}}</span> &middot; shutdown failures <span id="metricDeliveryShutdownFailures">{{.Metrics.ShutdownFailures}}</span></div>
        <div class="sub" id="metricDeliveryLastSuccess">last success {{if .Metrics.LastSuccessAt}}{{.Metrics.LastSuccessAt}}{{else}}&mdash;{{end}}</div>
        <div class="sub" id="metricDeliveryLastFailure">last failure {{if .Metrics.LastFailureAt}}{{.Metrics.LastFailureAt}}{{if .Metrics.LastFailureCode}} &middot; {{.Metrics.LastFailureCode}}{{end}}{{else}}&mdash;{{end}}</div>
      </div>
      <div class="card">
        <div class="k">Logs</div>
        <div class="v"><span class="badge {{healthClass (printf "%s" .Logs.State)}}" id="logDeliveryState">{{shapeFor (healthClass (printf "%s" .Logs.State))}}{{.Logs.State}}</span></div>
        <div class="sub"><span id="logDeliveryAttempts">{{.Logs.ExportAttempts}}</span> attempts &middot; <span id="logDeliverySuccesses">{{.Logs.ExportSuccesses}}</span> accepted &middot; <span id="logDeliveryFailures">{{.Logs.ExportFailures}}</span> failed</div>
        <div class="sub" id="logDeliveryFlushLine"{{if and (eq .Logs.ForceFlushFailures 0) (eq .Logs.ShutdownFailures 0)}} hidden{{end}}>flush failures <span id="logDeliveryFlushFailures">{{.Logs.ForceFlushFailures}}</span> &middot; shutdown failures <span id="logDeliveryShutdownFailures">{{.Logs.ShutdownFailures}}</span></div>
        <div class="sub" id="logDeliveryLastSuccess">last success {{if .Logs.LastSuccessAt}}{{.Logs.LastSuccessAt}}{{else}}&mdash;{{end}}</div>
        <div class="sub" id="logDeliveryLastFailure">last failure {{if .Logs.LastFailureAt}}{{.Logs.LastFailureAt}}{{if .Logs.LastFailureCode}} &middot; {{.Logs.LastFailureCode}}{{end}}{{else}}&mdash;{{end}}</div>
      </div>
    </div>
    {{end}}

    {{with .Capacity}}
    <div class="sub-h">Capacity <span class="tsum">Exact cumulative counters</span></div>
    <div class="cards c2" id="capacityStatus">
      <div class="card"><div class="k">Metrics transmitted payload</div><div class="v" id="capacityMetricBytes">{{.Transport.Metrics.TransmittedPayloadBytes}}</div><div class="sub">post-compression bytes &middot; <span id="capacityMetricRetries">{{.Transport.Metrics.RetryAttempts}}</span> exporter retries</div></div>
      <div class="card"><div class="k">Logs transmitted payload</div><div class="v" id="capacityLogBytes">{{.Transport.Logs.TransmittedPayloadBytes}}</div><div class="sub">post-compression bytes &middot; <span id="capacityLogRetries">{{.Transport.Logs.RetryAttempts}}</span> exporter retries</div></div>
    </div>
    <table id="capacityVolume">
      <thead><tr><th>Tenant</th><th>Collector</th><th>Transport</th><th>Traffic class</th><th class="num">Source records</th><th class="num">Metric points</th><th class="num">Log points</th></tr></thead>
      <tbody id="capacityVolumeBody">
      {{range .Volume}}
        <tr><td><code>{{.TenantID}}</code></td><td><code>{{.Collector}}</code></td><td>{{.IngestTransport}}</td><td>{{.TrafficClass}}</td><td class="num">{{.SourceRecords}}</td><td class="num">{{.MetricPoints}}</td><td class="num">{{.LogPoints}}</td></tr>
      {{else}}
        <tr><td colspan="7" class="muted">No attributed volume recorded yet.</td></tr>
      {{end}}
      </tbody>
    </table>

    {{with .Cost}}
    <div class="sub-h">Estimate, not invoice <span class="tsum">operator-supplied pricing; observational only</span></div>
    <p class="muted">Observed interval cost includes all observed traffic. Period projection and budget ratio include recurring steady_state only.</p>
    <div class="cards" id="costStatus">
      <div class="card"><div class="k">Recurring projected {{.Period}}</div><div class="v" id="costProjected">{{.ProjectedPeriodMicrounits}}</div><div class="sub">{{.Currency}} microunits &middot; <span id="costInterval">{{.IntervalMicrounits}}</span> observed interval cost across all traffic</div></div>
      <div class="card"><div class="k">Budget ratio</div><div class="v" id="costBudget">{{if .BudgetRatio}}{{printf "%.0f" .BudgetPercent}}%{{else}}&mdash;{{end}}</div><div class="sub" id="costBudgetDetail">recurring steady_state only &middot; {{if .BudgetRatio}}{{.ProjectedPeriodMicrounits}} / {{.BudgetMicrounits}} microunits{{else if .BudgetMicrounits}}collecting the first estimate{{else}}no budget comparison configured{{end}}</div></div>
      <div class="card"><div class="k">Price metadata</div><div class="v">{{.Version}}</div><div class="sub">{{.Source}} &middot; effective {{.EffectiveAt}}</div></div>
    </div>
    <table id="capacityCost">
      <thead><tr><th>Tenant</th><th>Collector</th><th>Transport</th><th>Traffic class</th><th>Attribution</th><th class="num">Allocated payload bytes</th><th class="num">Observed interval cost</th><th class="num">Recurring projected {{.Period}}</th></tr></thead>
      <tbody id="capacityCostBody">
      {{range .Rows}}
        <tr><td><code>{{.TenantID}}</code></td><td><code>{{.Collector}}</code></td><td>{{.IngestTransport}}</td><td>{{.TrafficClass}}</td><td><span class="chip">{{.Attribution}}</span></td><td class="num">{{.AllocatedPayloadBytes}}</td><td class="num">{{.IntervalMicrounits}}</td><td class="num">{{.ProjectedPeriodMicrounits}}</td></tr>
      {{else}}
        <tr><td colspan="8" class="muted">Collecting two complete metric intervals for the first estimate.</td></tr>
      {{end}}
      </tbody>
    </table>
    {{end}}
    {{end}}
  </section>

  <!-- ═══ COLLECTORS ═══ -->
  <section data-tab="collectors" id="panel-collectors" role="tabpanel" aria-labelledby="tab-collectors" class="wide">
    <div class="filterbar">
      <div class="filterwrap"><svg aria-hidden="true"><use href="#i-magnifying-glass"/></svg><input class="filter" id="collectorFilter" type="text" placeholder="Filter collectors…" aria-label="Filter collectors" oninput="filterAll(this)"></div>
      <span id="filterCount"></span>
    </div>
    <div id="tenants">
    {{range .Tenants}}
      <div class="sub-h">Tenant <code>{{.TenantID}}</code>
        <span class="tsum">{{.EnabledCount}} active{{if .FailingCount}} &middot; {{.FailingCount}} failing{{end}}{{if .PendingCount}} &middot; {{.PendingCount}} starting{{end}}{{if .CoveredCount}} &middot; {{.CoveredCount}} covered{{end}}{{if .SkippedCount}} &middot; {{.SkippedCount}} skipped{{end}}</span>
      </div>
      {{with .StartupFailure}}<div class="reasons"><span class="badge err">{{shapeFor "err"}}startup failed</span> <code>{{.Code}}</code> &middot; {{.Reason}}</div>{{end}}
      <table class="ctable">
        <thead><tr>
          <th>Collector</th><th>State</th><th class="num">Interval</th><th class="num">Success</th>
          <th class="num">Runs</th><th class="num">Failures</th><th class="num">Next run</th>
          <th class="num">Duration</th><th>Recent</th><th>Staleness</th><th>Last error</th>
        </tr></thead>
        <tbody>
        {{range .Collectors}}
          {{if .Enabled}}
          <tr{{if and .HasRun (not .LastSuccess)}} class="t2o-row--alert"{{end}}>
            <td><code>{{.Name}}</code>{{with .State}}<span class="cursor mono" title="durable checkpoint cursor">{{if eq .Kind "blob"}}cursor {{.ByteOffset}}B &middot; {{.BlobsTracked}} blobs{{if .NewestBlob}} &middot; newest <code>{{.NewestBlob}}</code>{{end}}{{else}}{{if .Watermark}}watermark {{.Watermark}} &middot; {{.Staleness}} behind{{else}}cold start{{end}}{{if .SeenIDs}} &middot; {{.SeenIDs}} seen{{end}}{{if .InFlightJob}} &middot; job <code>{{.InFlightJob}}</code>{{end}}{{end}}</span>{{end}}</td>
            <td class="sans">{{if .Availability}}<span class="badge {{.Availability.BadgeClass}}" data-state="{{.Availability.State}}">{{stateGlyph (printf "%s" .Availability.State)}}{{.Availability.State}}</span><span class="sub">{{.Availability.Reason}}{{range .Availability.Limitations}} &middot; {{.}}{{end}}{{if .Transport}} &middot; <span title="resolved collector transport">via {{.Transport}}</span>{{end}}</span>{{else}}{{if not .HasRun}}<span class="badge pending">{{shapeFor "pending"}}starting</span>{{else if .LastSuccess}}<span class="badge ok">{{shapeFor "ok"}}ok</span>{{else}}<span class="badge err">{{shapeFor "err"}}failing</span>{{end}}{{if .Transport}}<span class="sub"><span title="ingest transport">via {{.Transport}}</span></span>{{end}}{{end}}</td>
            <td class="num">{{.IntervalSec}}s</td>
            <td class="num">{{if .HasRun}}{{printf "%.0f" .SuccessRatePct}}%{{else}}<span class="muted">&mdash;</span>{{end}}</td>
            <td class="num">{{.Runs}}</td>
            <td class="num">{{.Failures}}{{if gt .ConsecutiveFailures 0}} <span class="muted">({{.ConsecutiveFailures}}&times;)</span>{{end}}</td>
            <td class="num">{{if not .HasRun}}<span class="muted">&mdash;</span>{{else if .Overdue}}<span class="overdue">overdue</span>{{else if le .NextRunInSec 0}}due{{else}}{{.NextRunIn}}{{end}}</td>
            <td class="num">{{if .HasRun}}{{.LastDurationMs}}ms{{else}}<span class="muted">&mdash;</span>{{end}}</td>
            <td class="recent">{{sparkline .DurationMsSeries}}{{outcomeStrip .OutcomeSeries}}</td>
            <td class="num">{{if .HasRun}}{{.Staleness}}{{else}}<span class="muted">&mdash;</span>{{end}}</td>
            <td class="err">{{if .LastError}}{{.LastError}}{{else}}<span class="muted">&mdash;</span>{{end}}</td>
          </tr>
          {{else if .CoveredBy}}
          <tr><td><code>{{.Name}}</code></td><td class="sans">{{if .Availability}}<span class="badge {{.Availability.BadgeClass}}" data-state="{{.Availability.State}}">{{stateGlyph (printf "%s" .Availability.State)}}{{.Availability.State}}</span>{{if .Transport}}<span class="sub"><span title="resolved collector transport">via {{.Transport}}</span></span>{{end}}{{else}}<span class="badge info">{{stateGlyph "covered"}}covered</span>{{end}}</td><td class="mono muted" colspan="9">collected via <code>{{.CoveredBy.Collector}}</code> <span title="covering collector transport">({{.CoveredBy.Transport}})</span>{{if .Availability}} &middot; {{.Availability.Reason}}{{range .Availability.Limitations}} &middot; {{.}}{{end}}{{else}} &middot; polled form off by design{{end}}</td></tr>
          {{else}}
          <tr><td><code>{{.Name}}</code></td><td class="sans">{{if .Availability}}<span class="badge {{.Availability.BadgeClass}}" data-state="{{.Availability.State}}">{{stateGlyph (printf "%s" .Availability.State)}}{{.Availability.State}}</span>{{else}}<span class="badge {{skipBadgeClass .SkipCategory}}">{{skipGlyph .SkipCategory}}{{if .SkipCategory}}{{.SkipCategory}}{{else}}skipped{{end}}</span>{{end}}</td><td class="mono muted" colspan="9">{{if .Availability}}{{.Availability.Reason}}{{range .Availability.Limitations}} &middot; {{.}}{{end}}{{else}}skipped &mdash; {{.SkipReason}}{{end}}{{if .Transport}} &middot; <span title="{{if .Availability}}resolved collector transport{{else}}ingest transport{{end}}">via {{.Transport}}</span>{{end}}</td></tr>
          {{end}}
        {{else}}
          <tr><td colspan="11" class="muted">No collectors registered or skipped for this tenant.</td></tr>
        {{end}}
        </tbody>
      </table>
    {{else}}
      <p class="muted">No tenants configured.</p>
    {{end}}
    </div>
    <div class="legendtab" id="stateLegend" aria-label="Collector state legend">
      <span>{{stateGlyph "healthy"}}<b>healthy</b> running, data returned</span>
      <span>{{stateGlyph "healthy_empty"}}<b>healthy_empty</b> running, tenant has none</span>
      <span>{{stateGlyph "limited"}}<b>limited</b> partial by source design</span>
      <span>{{stateGlyph "degraded"}}<b>degraded</b> emitting, quality reduced</span>
      <span>{{stateGlyph "blocked"}}<b>blocked</b> permission or licence</span>
      <span>{{stateGlyph "failed"}}<b>failed</b> the call returned an error</span>
      <span>{{stateGlyph "startup_failed"}}<b>startup_failed</b> never started</span>
      <span>{{stateGlyph "covered"}}<b>covered</b> another collector owns it, not a fault</span>
      <span>{{stateGlyph "disabled"}}<b>disabled</b> switched off</span>
      <span>{{stateGlyph "starting"}}<b>starting</b> no run yet</span>
    </div>
  </section>

  <!-- ═══ CONFIG ═══ -->
  <section data-tab="config" id="panel-config" role="tabpanel" aria-labelledby="tab-config">
    <div class="sub-h">Effective configuration<span class="tsum">secrets shown presence-only, never their value</span></div>
    <div class="kv">
      <div class="kvr"><span class="kk">Log level</span><span class="kvv">{{if .Config.LogLevel}}{{.Config.LogLevel}}{{else}}<span class="muted">&mdash;</span>{{end}}</span></div>
      <div class="kvr"><span class="kk">Tenants</span><span class="kvv">{{.Config.TenantCount}}</span></div>
      <div class="kvr"><span class="kk">Checkpoint dir</span><span class="kvv">{{if .Config.CheckpointDir}}{{.Config.CheckpointDir}}{{else}}<span class="muted">&mdash;</span>{{end}}</span></div>
      {{if .Config.RefreshInterval}}<div class="kvr"><span class="kk">Admin refresh interval</span><span class="kvv">{{.Config.RefreshInterval}}</span></div>{{end}}
      {{if .Config.BackfillInitialLookback}}<div class="kvr"><span class="kk">Backfill lookback</span><span class="kvv">{{.Config.BackfillInitialLookback}}</span></div>{{end}}
      <div class="kvr"><span class="kk">Cardinality per_metric_limit</span><span class="kvv">{{if .Config.Cardinality.PerMetricLimit}}{{.Config.Cardinality.PerMetricLimit}}{{else}}unlimited{{end}}</span></div>
    </div>

    <div class="sub-h">OTLP</div>
    <div class="kv">
      <div class="kvr"><span class="kk">Protocol</span><span class="kvv">{{.Config.OTLP.Protocol}}</span></div>
      <div class="kvr"><span class="kk">Endpoint</span><span class="kvv">{{.Config.OTLP.Endpoint}}</span></div>
      {{if .Config.OTLP.GrafanaInstanceID}}<div class="kvr"><span class="kk">Grafana Cloud instance</span><span class="kvv">{{.Config.OTLP.GrafanaInstanceID}}</span></div>{{end}}
      <div class="kvr"><span class="kk">Grafana Cloud token</span><span class="kvv">{{if .Config.OTLP.GrafanaTokenSet}}<span class="badge ok">{{shapeFor "ok"}}set</span>{{else}}<span class="badge muted">{{shapeFor "pending"}}unset</span>{{end}}</span></div>
    </div>

    <div class="sub-h">Profiling</div>
    <div class="kv">
      <div class="kvr"><span class="kk">Pyroscope</span><span class="kvv">{{if .Config.Profiling.PyroscopeEnabled}}<span class="badge ok">{{shapeFor "ok"}}on</span>{{else}}<span class="badge muted">{{shapeFor "pending"}}off</span>{{end}}</span></div>
      {{if .Config.Profiling.PyroscopeServerAddress}}<div class="kvr"><span class="kk">Server address</span><span class="kvv">{{.Config.Profiling.PyroscopeServerAddress}}</span></div>{{end}}
      {{if .Config.Profiling.PyroscopeBasicAuthUser}}<div class="kvr"><span class="kk">Basic-auth user</span><span class="kvv">{{.Config.Profiling.PyroscopeBasicAuthUser}}</span></div>{{end}}
      <div class="kvr"><span class="kk">Basic-auth password</span><span class="kvv">{{if .Config.Profiling.PyroscopeBasicAuthPasswordSet}}<span class="badge ok">{{shapeFor "ok"}}set</span>{{else}}<span class="badge muted">{{shapeFor "pending"}}unset</span>{{end}}</span></div>
      <div class="kvr"><span class="kk">Mutex profile fraction</span><span class="kvv">{{.Config.Profiling.MutexProfileFraction}}</span></div>
      <div class="kvr"><span class="kk">Block profile rate</span><span class="kvv">{{.Config.Profiling.BlockProfileRate}}</span></div>
    </div>

    {{if .Config.Collectors}}
    <div class="sub-h">Collector overrides <span class="tsum">global</span></div>
    <table>
      <thead><tr><th>Collector</th><th>Enabled</th><th>Interval</th><th>Source</th></tr></thead>
      <tbody>
      {{range .Config.Collectors}}
        <tr><td><code>{{.Name}}</code></td><td>{{.EnabledLabel}}</td><td>{{if .Interval}}{{.Interval}}{{else}}<span class="muted">&mdash;</span>{{end}}</td><td>{{if .Source}}{{.Source}}{{else}}<span class="muted">&mdash;</span>{{end}}</td></tr>
      {{end}}
      </tbody>
    </table>
    {{end}}

    {{if .Config.Tenants}}
    <div class="sub-h">Tenants</div>
    <table>
      <thead><tr><th>Tenant</th><th>Client ID</th><th>Exclude self</th><th>Blob ingest</th><th>Collector overrides</th></tr></thead>
      <tbody>
      {{range .Config.Tenants}}
        <tr>
          <td><code>{{.TenantID}}</code></td>
          <td>{{if .ClientID}}{{.ClientID}}{{else}}<span class="muted">&mdash;</span>{{end}}</td>
          <td>{{if .ExcludeSelf}}yes{{else}}<span class="muted">no</span>{{end}}</td>
          <td class="sans">{{if .BlobIngest}}<span class="badge ok">{{shapeFor "ok"}}on</span>{{else}}<span class="badge muted">{{shapeFor "pending"}}off</span>{{end}}</td>
          <td>{{range .Overrides}}<code>{{.Name}}</code>{{if .Interval}}={{.Interval}}{{end}} {{else}}<span class="muted">&mdash;</span>{{end}}</td>
        </tr>
      {{end}}
      </tbody>
    </table>
    {{end}}
  </section>

  <!-- ═══ CARDINALITY ═══ -->
  <section data-tab="cardinality" id="panel-cardinality" role="tabpanel" aria-labelledby="tab-cardinality">
    <div class="rollup">
      <div class="rc"><span class="rv">{{.Cardinality.TotalActiveSeries}}</span><span class="rk">active series</span></div>
      <div class="rc"><span class="rv">{{.Cardinality.MetricCount}}</span><span class="rk">metrics</span></div>
      <div class="rc"><span class="rv">{{if .Cardinality.PerMetricLimit}}{{.Cardinality.PerMetricLimit}}{{else}}&infin;{{end}}</span><span class="rk">per_metric_limit</span></div>
      <div class="rc"><span class="rv{{if .Cardinality.Offenders}} err{{end}}">{{len .Cardinality.Offenders}}</span><span class="rk">offenders</span></div>
    </div>
    <p class="muted" style="margin:0 0 8px">Output-side active series (the series graph2otel is about to ship this export interval), after cardinality limiting — what actually gets billed. Push-based, so this is not a <code>/metrics</code> scrape.</p>

    {{if .Cardinality.Offenders}}
    <div class="sub-h">High-cardinality offenders</div>
    <table>
      <thead><tr><th>Metric</th><th>Level</th><th class="num">Series</th><th class="num">Headroom</th></tr></thead>
      <tbody>
      {{range .Cardinality.Offenders}}
        <tr class="t2o-row--alert"><td><code>{{.Metric}}</code></td><td class="sans">{{if .Capped}}<span class="badge err">{{stateGlyph "failed"}}uncounted</span>{{else}}<span class="badge warn">{{stateGlyph "limited"}}near limit</span>{{end}}</td><td class="num">{{.Count}}</td><td class="num">{{if $.Cardinality.PerMetricLimit}}{{printf "%.0f" .HeadroomPct}}%{{else}}<span class="muted">&mdash;</span>{{end}}</td></tr>
      {{end}}
      </tbody>
    </table>
    {{end}}

    <div class="sub-h">Active series per metric</div>
    {{if .Cardinality.Metrics}}
    <table>
      <thead><tr><th>Metric</th><th>Level</th><th class="num">Series</th><th class="num">Headroom</th></tr></thead>
      <tbody>
      {{range .Cardinality.Metrics}}
        <tr><td><code>{{.Metric}}</code></td><td class="sans">{{if .Capped}}<span class="badge err">{{stateGlyph "failed"}}uncounted</span>{{else}}<span class="badge muted">{{shapeFor "ok"}}ok</span>{{end}}</td><td class="num">{{.Count}}</td><td class="num">{{if $.Cardinality.PerMetricLimit}}{{printf "%.0f" .HeadroomPct}}%{{else}}<span class="muted">&mdash;</span>{{end}}</td></tr>
      {{end}}
      </tbody>
    </table>
    {{else}}
    <p class="muted">No active series recorded yet — self-observability is off, or no export interval has completed.</p>
    {{end}}
  </section>

</main>
