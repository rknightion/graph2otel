</footer>
<script>
var SVGNS='http://www.w3.org/2000/svg';
var lastOkMs=Date.now(), pollTimer=null, paused=false;

function ic(id,cls){ var s=document.createElementNS(SVGNS,'svg'); s.setAttribute('class',cls||'gl'); s.setAttribute('aria-hidden','true'); var u=document.createElementNS(SVGNS,'use'); u.setAttribute('href','#'+id); s.appendChild(u); return s; }
// Glyph ids match stateGlyphName / shapeName in template.go.
function stateGlyphId(state){
  if(state==='healthy'||state==='healthy_empty')return 's-circle';
  if(state==='limited'||state==='degraded')return 'i-warning';
  if(state==='blocked')return 'i-prohibit';
  if(state==='failed'||state==='startup_failed')return 'i-warning-circle';
  if(state==='covered')return 'i-arrows-split';
  return 's-ring';
}
function shapeId(cls){ return cls==='ok'?'s-circle':(cls==='err'?'s-diamond':'s-ring'); }
function badge(cls,word,glyph,state){ var b=el('span',{'class':'badge '+cls}); if(state) b.setAttribute('data-state',state); if(glyph) b.appendChild(ic(glyph)); b.appendChild(document.createTextNode(word)); return b; }
function setBadge(node,cls,word,extra){ if(!node) return; node.className='badge '+(extra?extra+' ':'')+cls; node.textContent=''; node.appendChild(ic(shapeId(cls))); node.appendChild(document.createTextNode(word)); }
function headroomClass(p){ return p>60?'ok':(p>=20?'warn':'err'); }

function showTab(id){
  var secs=document.querySelectorAll('section[data-tab]'), found=false;
  for(var i=0;i<secs.length;i++){ var on=secs[i].getAttribute('data-tab')===id; secs[i].classList.toggle('active',on); if(on) found=true; }
  var btns=document.querySelectorAll('#tabs .tab-btn');
  for(var j=0;j<btns.length;j++){ var sel=btns[j].getAttribute('data-target')===id; btns[j].classList.toggle('active',sel); btns[j].setAttribute('aria-selected',sel?'true':'false'); btns[j].setAttribute('tabindex',sel?'0':'-1'); }
  if(found && location.hash!=='#'+id){ history.replaceState(null,'','#'+id); }
  // A chart inside a hidden section measures 0 wide, so anything drawn before
  // its tab was shown is wrong. Redraw whatever just became visible.
  redrawCharts();
}
function handleTabsKeydown(ev){
  var k=ev.key; if(k!=='ArrowLeft'&&k!=='ArrowRight'&&k!=='Home'&&k!=='End') return;
  var btns=[].slice.call(document.querySelectorAll('#tabs .tab-btn')), cur=btns.indexOf(document.activeElement); if(cur<0) cur=0;
  var next=k==='Home'?0:(k==='End'?btns.length-1:(cur+(k==='ArrowRight'?1:-1)+btns.length)%btns.length);
  ev.preventDefault(); btns[next].focus(); showTab(btns[next].getAttribute('data-target'));
}
function initTabs(){
  var btns=document.querySelectorAll('#tabs .tab-btn');
  for(var i=0;i<btns.length;i++){ (function(b){ b.addEventListener('click',function(){ showTab(b.getAttribute('data-target')); }); })(btns[i]); }
  var nav=document.getElementById('tabs'); if(nav) nav.addEventListener('keydown',handleTabsKeydown);
  var initial=(location.hash||'').replace('#','');
  showTab(document.querySelector('section[data-tab="'+initial+'"]')?initial:'overview');
}
// Light is the default; the OS preference applies only when nothing is stored, and an explicit data-theme wins.
function currentTheme(){ var t=document.documentElement.getAttribute('data-theme'); if(t) return t; return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light'; }
function toggleTheme(){ var next=currentTheme()==='light'?'dark':'light'; document.documentElement.setAttribute('data-theme',next); try{localStorage.setItem('graph2otel-theme',next);}catch(e){} redrawCharts(); }

function el(tag,attrs,text){ var e=document.createElement(tag); if(attrs){ for(var k in attrs){ if(attrs.hasOwnProperty(k)) e.setAttribute(k,attrs[k]); } } if(text!=null) e.textContent=text; return e; }
function setText(id,v){ var e=document.getElementById(id); if(e!=null && v!=null) e.textContent=v; }
function relMs(ms){ var s=Math.round((Date.now()-ms)/1000); if(s<0)s=0; if(s<60)return s+'s ago'; if(s<3600)return Math.floor(s/60)+'m ago'; if(s<86400)return Math.floor(s/3600)+'h ago'; return Math.floor(s/86400)+'d ago'; }
function applyFilter(){
  var input=document.getElementById('collectorFilter'); if(!input) return;
  var q=input.value.toLowerCase(), rows=document.querySelectorAll('#tenants table tbody tr'), shown=0;
  for(var i=0;i<rows.length;i++){ var m=rows[i].textContent.toLowerCase().indexOf(q)>-1; rows[i].style.display=m?'':'none'; if(m) shown++; }
  var c=document.getElementById('filterCount'); if(c) c.textContent=shown+' of '+rows.length;
}
function filterAll(){ applyFilter(); }

function drawSpark(svg,arr){
  if(!svg) return; while(svg.firstChild) svg.removeChild(svg.firstChild);
  if(!arr || arr.length<2) return;
  var W=100,H=22,n=arr.length,mn=arr[0],mx=arr[0],i;
  for(i=1;i<n;i++){ if(arr[i]<mn)mn=arr[i]; if(arr[i]>mx)mx=arr[i]; }
  var span=(mx-mn)||1,pts='';
  for(i=0;i<n;i++){ var x=i*(W)/(n-1); var y=H-(arr[i]-mn)/span*H; pts+=(i?' ':'')+x.toFixed(1)+','+y.toFixed(1); }
  svg.setAttribute('viewBox','0 0 '+W+' '+H); svg.setAttribute('preserveAspectRatio','none');
  var pl=document.createElementNS(SVGNS,'polyline'); pl.setAttribute('points',pts); svg.appendChild(pl);
}
function newSpark(){ var s=document.createElementNS(SVGNS,'svg'); s.setAttribute('class','spark'); s.setAttribute('aria-hidden','true'); return s; }

// ── Line charts: the family small-chart standard ───────────────────────────
// Geometry is frozen: padL 44 / padR 8 / padT 8 / padB 14. The three value
// labels sit in the 44px gutter, OUTSIDE the plot, because an axis label over the
// area fill fails AA in dark. Three series at most; slot 1 solid, slot 2 dashed,
// slot 3 dotted, so colour is never the only carrier. Area only for one series.
// CHARTS maps an <svg> id to the function that pulls its series out of the
// latest status payload, so a refresh, a tab switch and a theme toggle can all
// redraw every chart from one place. A seriesFn returns null when the source is
// switched off (rendered as such, never as a flat line at zero).
var CHARTS={}, lastData=null;
var PAD_L=44, PAD_R=8, PAD_T=8, PAD_B=14;
function registerChart(svgId,seriesFn,fmtFn,offMsg){ CHARTS[svgId]={seriesFn:seriesFn,fmt:fmtFn||function(v){return String(Math.round(v));},off:offMsg||'no data reported'}; }
function redrawCharts(){ for(var id in CHARTS){ if(CHARTS.hasOwnProperty(id)){ var c=CHARTS[id]; drawChart(id,c.seriesFn(lastData),c.fmt,c.off); } } }
function svgNode(tag,attrs){ var n=document.createElementNS(SVGNS,tag); for(var k in attrs){ if(attrs.hasOwnProperty(k)) n.setAttribute(k,attrs[k]); } return n; }
function chartNote(svg,H,glyph,text){
  var u=svgNode('use',{href:'#'+glyph,x:PAD_L-40,y:H/2-6,width:12,height:12,'class':'noteic'}); svg.appendChild(u);
  var t=svgNode('text',{x:PAD_L-24,y:H/2+4,'class':'note'}); t.textContent=text; svg.appendChild(t);
}
function chartLegend(svg,series,fmt){
  var wrap=svg.parentNode, card=wrap?wrap.parentNode:null, lg=card?card.querySelector('.legend'):null; if(!lg) return;
  lg.textContent='';
  series.forEach(function(s,si){
    var item=el('span',{'class':'lg'}), sw=svgNode('svg',{viewBox:'0 0 14 6','aria-hidden':'true'});
    sw.appendChild(svgNode('line',{x1:0,x2:14,y1:3,y2:3,'class':'ln s'+(si+1)}));
    item.appendChild(sw);
    item.appendChild(document.createTextNode(s.name+' '+(s.points.length?fmt(s.points[s.points.length-1]):'—')));
    lg.appendChild(item);
  });
}
function drawChart(svgId,series,fmt,offMsg){
  var svg=document.getElementById(svgId); if(!svg) return;
  var wrap=svg.parentNode, tip=wrap?wrap.querySelector('.chart-tip'):null;
  while(svg.firstChild) svg.removeChild(svg.firstChild);
  var rect=svg.getBoundingClientRect();
  var W=Math.max(rect.width||300,120), H=Math.max(rect.height||110,50);
  svg.setAttribute('viewBox','0 0 '+W+' '+H); svg.setAttribute('preserveAspectRatio','none');
  if(series===null){ chartLegend(svg,[],fmt); chartNote(svg,H,'s-ring',offMsg); return; }
  series=series.filter(function(s){ return s.points && s.points.length; }).slice(0,3);
  chartLegend(svg,series,fmt);
  var maxLen=0,mn=Infinity,mx=-Infinity;
  series.forEach(function(s){ maxLen=Math.max(maxLen,s.points.length); s.points.forEach(function(v){ if(v<mn)mn=v; if(v>mx)mx=v; }); });
  // Fewer than two points is not a chart yet: say so rather than drawing a dot.
  if(!series.length || maxLen<2){ chartNote(svg,H,'i-info','collecting, '+maxLen+' of 2 samples'); return; }
  if(mn===mx){ mx=mn+1; }
  var plotW=W-PAD_L-PAD_R, plotH=H-PAD_T-PAD_B;
  function xAt(i){ return PAD_L+i*plotW/(maxLen-1); }
  function yAt(v){ return PAD_T+(1-(v-mn)/(mx-mn))*plotH; }
  [0,0.5,1].forEach(function(f){
    var val=mn+(mx-mn)*f, y=yAt(val);
    svg.appendChild(svgNode('line',{x1:PAD_L,x2:W-PAD_R,y1:y,y2:y,'class':'grid'}));
    var tx=svgNode('text',{x:4,y:y+3,'class':'ax'}); tx.textContent=fmt(val); svg.appendChild(tx);
  });
  series.forEach(function(s,si){
    var pts=s.points.map(function(v,i){ return xAt(i)+','+yAt(v); }).join(' ');
    if(series.length===1){
      svg.appendChild(svgNode('polygon',{points:xAt(0)+','+(PAD_T+plotH)+' '+pts+' '+xAt(s.points.length-1)+','+(PAD_T+plotH),'class':'area'}));
    }
    svg.appendChild(svgNode('polyline',{points:pts,'class':'ln s'+(si+1)}));
  });
  if(tip){
    var cross=svgNode('line',{y1:PAD_T,y2:PAD_T+plotH,'class':'cross'}); cross.style.display='none'; svg.appendChild(cross);
    var dot=svgNode('circle',{r:2.5,'class':'dot'}); dot.style.display='none'; svg.appendChild(dot);
    var over=svgNode('rect',{x:PAD_L,y:PAD_T,width:plotW,height:plotH,fill:'transparent'}); svg.appendChild(over);
    over.addEventListener('mousemove',function(ev){
      var b=svg.getBoundingClientRect();
      var px=(ev.clientX-b.left)*(W/b.width);
      var i=Math.round((px-PAD_L)/plotW*(maxLen-1)); if(i<0)i=0; if(i>maxLen-1)i=maxLen-1;
      cross.setAttribute('x1',xAt(i)); cross.setAttribute('x2',xAt(i)); cross.style.display='';
      var v1=series[0].points[Math.min(i,series[0].points.length-1)];
      dot.setAttribute('cx',xAt(i)); dot.setAttribute('cy',yAt(v1)); dot.style.display='';
      var parts=series.map(function(s){ var v=s.points[Math.min(i,s.points.length-1)]; return s.name+' '+fmt(v); });
      tip.textContent=parts.join(' · '); tip.style.display='block';
      tip.style.left=(xAt(i)/W*b.width)+'px'; tip.style.top=(PAD_T/H*b.height)+'px';
    });
    over.addEventListener('mouseleave',function(){ cross.style.display='none'; dot.style.display='none'; tip.style.display='none'; });
  }
}
function outcomeStripEl(arr){
  var span=el('span',{'class':'outcome'}); if(!arr) return span;
  var start=arr.length>40?arr.length-40:0, failed=0;
  for(var i=start;i<arr.length;i++){ var d=el('i'); if(!arr[i]){ d.className='f'; failed++; } span.appendChild(d); }
  var holder=document.createDocumentFragment(); holder.appendChild(span);
  if(arr.length) holder.appendChild(el('span',{'class':'ocount'},failed+' of '+(arr.length-start)+' failed'));
  return holder;
}
function availabilityClass(state){
  if(state==='healthy'||state==='healthy_empty')return 'ok';
  if(state==='limited'||state==='degraded')return 'warn';
  if(state==='blocked'||state==='failed'||state==='startup_failed')return 'err';
  if(state==='covered')return 'info';
  if(state==='disabled')return 'muted';
  return 'pending';
}
function appendAvailability(td,c){
  var a=c.availability; if(!a)return false;
  var st=a.state||'unknown';
  td.appendChild(badge(availabilityClass(st),st,stateGlyphId(st),st));
  var detail=a.reason||''; if(a.limitations&&a.limitations.length)detail+=(detail?' · ':'')+a.limitations.join(' · ');
  var sub=el('span',{'class':'sub'},detail);
  if(c.transport){ if(detail) sub.appendChild(document.createTextNode(' · ')); sub.appendChild(el('span',{'title':'resolved collector transport'},'via '+c.transport)); }
  td.appendChild(sub);
  return true;
}

function collectorRow(c){
  if(c.enabled){
    var tr=el('tr'); if(c.has_run && !c.last_success) tr.className='t2o-row--alert';
    var nameTd=el('td'); nameTd.appendChild(el('code',null,c.name));
    if(c.state){ var cur=el('span',{'class':'cursor mono','title':'durable checkpoint cursor'}); if(c.state.kind==='blob'){ cur.textContent='cursor '+(c.state.byte_offset||0)+'B · '+(c.state.blobs_tracked||0)+' blobs'+(c.state.newest_blob?' · newest '+c.state.newest_blob:''); } else { cur.textContent=c.state.watermark?('watermark '+c.state.watermark+' · '+(c.state.staleness||'')+' behind'):'cold start'; } nameTd.appendChild(cur); }
    tr.appendChild(nameTd);
    var stTd=el('td',{'class':'sans'});
    if(!appendAvailability(stTd,c)){
      if(!c.has_run) stTd.appendChild(badge('pending','starting','s-ring')); else if(c.last_success) stTd.appendChild(badge('ok','ok','s-circle')); else stTd.appendChild(badge('err','failing','s-diamond'));
      if(c.transport){ var vs=el('span',{'class':'sub'}); vs.appendChild(el('span',{'title':'ingest transport'},'via '+c.transport)); stTd.appendChild(vs); }
    }
    tr.appendChild(stTd);
    tr.appendChild(el('td',{'class':'num'}, (c.interval_seconds||0)+'s'));
    tr.appendChild(el('td',{'class':'num'}, c.has_run?Math.round(c.success_rate_pct)+'%':'—'));
    tr.appendChild(el('td',{'class':'num'}, String(c.runs||0)));
    tr.appendChild(el('td',{'class':'num'}, String(c.failures||0)+(c.consecutive_failures>0?' ('+c.consecutive_failures+'×)':'')));
    var nrTd=el('td',{'class':'num'}); if(!c.has_run) nrTd.appendChild(el('span',{'class':'muted'},'—')); else if(c.overdue) nrTd.appendChild(el('span',{'class':'overdue'},'overdue')); else nrTd.textContent=(c.next_run_in_seconds<=0?'due':(c.next_run_in||'due')); tr.appendChild(nrTd);
    tr.appendChild(el('td',{'class':'num'}, c.has_run?(c.last_duration_ms+'ms'):'—'));
    var recTd=el('td',{'class':'recent'}); if(c.duration_ms_series && c.duration_ms_series.length>1){ var sp=newSpark(); recTd.appendChild(sp); drawSpark(sp,c.duration_ms_series); } recTd.appendChild(outcomeStripEl(c.outcome_series)); tr.appendChild(recTd);
    tr.appendChild(el('td',{'class':'num'}, c.has_run?(c.staleness||''):'—'));
    var erTd=el('td',{'class':'err'}); if(c.last_error) erTd.textContent=c.last_error; else erTd.appendChild(el('span',{'class':'muted'},'—')); tr.appendChild(erTd);
    return tr;
  }
  if(c.covered_by){
    var tr2=el('tr'); tr2.appendChild(el('td')).appendChild(el('code',null,c.name)); var cTd=el('td',{'class':'sans'});
    if(!appendAvailability(cTd,c)) cTd.appendChild(badge('info','covered','i-arrows-split'));
    else { /* appendAvailability put the reason on the state line; the detail cell repeats it, so keep only the badge here */ while(cTd.childNodes.length>1) cTd.removeChild(cTd.lastChild); if(c.transport){ var cs=el('span',{'class':'sub'}); cs.appendChild(el('span',{'title':'resolved collector transport'},'via '+c.transport)); cTd.appendChild(cs); } }
    tr2.appendChild(cTd); var coveredTd=el('td',{'class':'mono muted','colspan':'9'}); coveredTd.appendChild(document.createTextNode('collected via ')); coveredTd.appendChild(el('code',null,c.covered_by.collector)); coveredTd.appendChild(document.createTextNode(' ')); coveredTd.appendChild(el('span',{'title':'covering collector transport'},'('+c.covered_by.transport+')'));
    if(c.availability){ var cd=c.availability.reason||''; if(c.availability.limitations&&c.availability.limitations.length) cd+=(cd?' · ':'')+c.availability.limitations.join(' · '); if(cd) coveredTd.appendChild(document.createTextNode(' · '+cd)); } else coveredTd.appendChild(document.createTextNode(' · polled form off by design'));
    tr2.appendChild(coveredTd); return tr2;
  }
  var tr3=el('tr'); tr3.appendChild(el('td')).appendChild(el('code',null,c.name)); var sTd=el('td',{'class':'sans'});
  if(c.availability){ var as=c.availability.state||'unknown'; sTd.appendChild(badge(availabilityClass(as),as,stateGlyphId(as),as)); }
  else { var sc=skipClass(c.skip_category); sTd.appendChild(badge(sc,c.skip_category||'skipped',skipGlyphId(c.skip_category))); }
  tr3.appendChild(sTd);
  var skipTd=el('td',{'class':'mono muted','colspan':'9'});
  if(c.availability){ var sd=c.availability.reason||''; if(c.availability.limitations&&c.availability.limitations.length) sd+=(sd?' · ':'')+c.availability.limitations.join(' · '); skipTd.textContent=sd; } else skipTd.textContent='skipped — '+(c.skip_reason||'');
  if(c.transport){ if(skipTd.textContent)skipTd.appendChild(document.createTextNode(' · ')); skipTd.appendChild(el('span',{'title':c.availability?'resolved collector transport':'ingest transport'},'via '+c.transport)); }
  tr3.appendChild(skipTd); return tr3;
}
function skipClass(cat){ if(cat==='license')return 'warn'; if(cat==='experimental')return 'info'; return 'muted'; }
function skipGlyphId(cat){ if(cat==='license')return 'i-warning'; if(cat==='experimental')return 'i-info'; return ''; }

function tenantSummary(t){
  var parts=[t.enabled_count+' active'];
  if(t.failing_count) parts.push(t.failing_count+' failing');
  if(t.pending_count) parts.push(t.pending_count+' starting');
  if(t.covered_count) parts.push(t.covered_count+' covered');
  if(t.skipped_count) parts.push(t.skipped_count+' skipped');
  return parts.join(' · ');
}
function rebuildTenants(tenants){
  var host=document.getElementById('tenants'); if(!host) return; host.textContent='';
  if(!tenants||!tenants.length){ host.appendChild(el('p',{'class':'muted'},'No tenants configured.')); applyFilter(); return; }
  tenants.forEach(function(t){
    var h=el('div',{'class':'sub-h'}); h.appendChild(document.createTextNode('Tenant ')); h.appendChild(el('code',null,t.tenant_id)); h.appendChild(el('span',{'class':'tsum'}, tenantSummary(t))); host.appendChild(h);
    if(t.startup_failure){ var sf=el('div',{'class':'reasons'}); sf.appendChild(badge('err','startup failed','s-diamond')); sf.appendChild(document.createTextNode(' ')); sf.appendChild(el('code',null,t.startup_failure.code)); sf.appendChild(document.createTextNode(' · '+t.startup_failure.reason)); host.appendChild(sf); }
    var table=el('table',{'class':'ctable'}); var thead=el('thead'); thead.innerHTML='<tr><th>Collector</th><th>State</th><th class="num">Interval</th><th class="num">Success</th><th class="num">Runs</th><th class="num">Failures</th><th class="num">Next run</th><th class="num">Duration</th><th>Recent</th><th>Staleness</th><th>Last error</th></tr>'; table.appendChild(thead);
    var tb=el('tbody');
    var cols=(t.collectors||[]);
    if(!cols.length){ var tr0=el('tr'); tr0.appendChild(el('td',{'colspan':'11','class':'muted'},'No collectors registered or skipped for this tenant.')); tb.appendChild(tr0); }
    else cols.forEach(function(c){ tb.appendChild(collectorRow(c)); });
    table.appendChild(tb); host.appendChild(table);
  });
  applyFilter();
}
function rebuildThrottle(tenants){
  var host=document.getElementById('throttle'); if(!host) return; host.textContent='';
  (tenants||[]).forEach(function(t){
    if(!t.rate_limits || !t.rate_limits.length) return;
    var h=el('div',{'class':'sub-h'}); h.style.margin='14px 0 4px'; h.appendChild(document.createTextNode('Tenant ')); h.appendChild(el('code',null,t.tenant_id)); host.appendChild(h);
    var table=el('table',{'class':'rl'}); var thead=el('thead'); thead.innerHTML='<tr><th>Workload</th><th class="num">limit/s</th><th class="num">burst</th><th class="num">tokens</th><th class="num">headroom</th><th>trend</th></tr>'; table.appendChild(thead);
    var tb=el('tbody');
    t.rate_limits.forEach(function(r){
      var hc='hr-'+headroomClass(r.headroom_pct);
      var tr=el('tr'); tr.appendChild(el('td')).appendChild(el('code',null,r.workload)); tr.appendChild(el('td',{'class':'num'}, Number(r.limit_per_sec).toPrecision(3))); tr.appendChild(el('td',{'class':'num'}, String(r.burst))); tr.appendChild(el('td',{'class':'num'}, Number(r.tokens_available).toFixed(1))); tr.appendChild(el('td',{'class':'num '+hc}, Math.round(r.headroom_pct)+'%'));
      var trTd=el('td',{'class':hc}); if(r.headroom_series && r.headroom_series.length>1){ var sp=newSpark(); trTd.appendChild(sp); drawSpark(sp,r.headroom_series); } tr.appendChild(trTd);
      tb.appendChild(tr);
    });
    table.appendChild(tb); host.appendChild(table);
  });
}
function updateTrends(d){
  if(d.runtime){
    setText('goroutines',d.runtime.goroutines); setText('gomaxprocs',d.runtime.gomaxprocs);
    setText('heapAlloc',d.runtime.heap_alloc); setText('numGC',d.runtime.num_gc);
    var gr=d.runtime.gc_rate_series;
    setText('gcRate', (gr && gr.length) ? gr[gr.length-1].toFixed(2) : '—');
  }
  if(d.throughput){
    setText('metricRate', (d.throughput.metric_points_per_sec||0).toFixed(1));
    setText('logRate', (d.throughput.log_records_per_sec||0).toFixed(1));
  }
  if(d.cardinality) setText('activeSeries', d.cardinality.total_series);
  if(d.fleet){
    setText('fleetFailing',d.fleet.failing); setText('fleetEnabled',d.fleet.enabled);
    setText('fleetPending',d.fleet.pending);
    setText('meanDuration', Math.round(d.fleet.mean_duration_ms||0)+'ms');
  }
}
function setTabCount(id,n){ var w=document.getElementById(id); if(!w) return; w.hidden=!(n>0); setText(id+'N',n); }
function updateRollup(d){
  var ready=d.readiness&&d.readiness.ready;
  var hc=d.health==='healthy'?'ok':(d.health==='degraded'?'err':'pending');
  var rh=document.getElementById('ruHealth'); if(rh){ rh.textContent=d.health; rh.className='rv '+hc; }
  var rr=document.getElementById('ruReadiness'); if(rr){ rr.textContent=d.readiness ? d.readiness.state : ''; rr.className='rv '+(ready?'ok':'err'); }
  setText('ruTenants', (d.tenants||[]).length);
  var enabled=0,failing=0,pending=0;
  (d.tenants||[]).forEach(function(t){ enabled+=t.enabled_count||0; failing+=t.failing_count||0; pending+=t.pending_count||0; });
  setText('ruEnabled',enabled); setText('ruFailing',failing); setText('ruPending',pending);
  var rf=document.getElementById('ruFailing'); if(rf) rf.className='rv'+(failing>0?' err':'');
  setTabCount('tabFailing',failing);
}
function updateDelivery(d){
  if(!d.delivery || !document.getElementById('deliveryStatus')) return;
  [['metric',d.delivery.metrics],['log',d.delivery.logs]].forEach(function(row){
    var prefix=row[0], signal=row[1]||{}, state=document.getElementById(prefix+'DeliveryState');
    if(state) setBadge(state, signal.state==='healthy'?'ok':signal.state==='degraded'?'err':'pending', signal.state||'');
    setText(prefix+'DeliveryAttempts',signal.export_attempts);
    setText(prefix+'DeliverySuccesses',signal.export_successes);
    setText(prefix+'DeliveryFailures',signal.export_failures);
    setText(prefix+'DeliveryFlushFailures',signal.force_flush_failures);
    setText(prefix+'DeliveryShutdownFailures',signal.shutdown_failures);
    var fl=document.getElementById(prefix+'DeliveryFlushLine'); if(fl) fl.hidden=!(signal.force_flush_failures>0||signal.shutdown_failures>0);
    var success=document.getElementById(prefix+'DeliveryLastSuccess');
    if(success) success.textContent='last success '+(signal.last_success_at||'—');
    var failure=document.getElementById(prefix+'DeliveryLastFailure');
    if(failure) failure.textContent='last failure '+(signal.last_failure_at||'—')+(signal.last_failure_code?' · '+signal.last_failure_code:'');
  });
}
function rebuildCapacity(c){
  if(!c || !document.getElementById('capacityStatus')) return;
  setText('capacityMetricBytes',c.transport.metrics.transmitted_payload_bytes);
  setText('capacityMetricRetries',c.transport.metrics.retry_attempts);
  setText('capacityLogBytes',c.transport.logs.transmitted_payload_bytes);
  setText('capacityLogRetries',c.transport.logs.retry_attempts);
  var volume=document.getElementById('capacityVolumeBody');
  if(volume){
    volume.textContent='';
    (c.volume||[]).forEach(function(r){
      var tr=el('tr');
      [r.tenant_id,r.collector,r.ingest_transport,r.traffic_class,r.source_records,r.metric_points,r.log_points].forEach(function(v,i){
        var td=el('td',i>=4?{'class':'num'}:null);
        if(i<2) td.appendChild(el('code',null,String(v))); else td.textContent=String(v);
        tr.appendChild(td);
      });
      volume.appendChild(tr);
    });
    if(!c.volume || !c.volume.length){ var empty=el('tr'); empty.appendChild(el('td',{'colspan':'7','class':'muted'},'No attributed volume recorded yet.')); volume.appendChild(empty); }
  }
  if(!c.cost || !document.getElementById('costStatus')) return;
  setText('costProjected',c.cost.projected_period_microunits);
  setText('costInterval',c.cost.interval_microunits);
  setText('costBudget',c.cost.budget_ratio==null?'—':Math.round(c.cost.budget_ratio*100)+'%');
  setText('costBudgetDetail','recurring steady_state only · '+(
    c.cost.budget_ratio!=null
      ? c.cost.projected_period_microunits+' / '+c.cost.budget_microunits+' microunits'
      : c.cost.budget_microunits
        ? 'collecting the first estimate'
        : 'no budget comparison configured'
  ));
  var costs=document.getElementById('capacityCostBody');
  if(costs){
    costs.textContent='';
    (c.cost.rows||[]).forEach(function(r){
      var tr=el('tr');
      [r.tenant_id,r.collector,r.ingest_transport,r.traffic_class,r.attribution,r.allocated_payload_bytes,r.interval_microunits,r.projected_period_microunits].forEach(function(v,i){
        var td=el('td',i>=5?{'class':'num'}:null);
        if(i<2) td.appendChild(el('code',null,String(v)));
        else if(i===4) td.appendChild(el('span',{'class':'chip'},String(v)));
        else td.textContent=String(v);
        tr.appendChild(td);
      });
      costs.appendChild(tr);
    });
    if(!c.cost.rows || !c.cost.rows.length){ var empty=el('tr'); empty.appendChild(el('td',{'colspan':'8','class':'muted'},'Collecting two complete metric intervals for the first estimate.')); costs.appendChild(empty); }
  }
}
function setHealth(d){
  var cls=d.health==='healthy'?'ok':d.health==='degraded'?'err':'pending';
  var b=document.getElementById('healthBadge'); if(b){ setBadge(b,cls,d.health,'chip'); b.title=(d.health_reasons||[]).join('\n'); }
  var rb=document.getElementById('healthReasons'); if(rb){ if(d.health_reasons && d.health_reasons.length){ setText('healthReasonsText',d.health_reasons.join(' · ')); rb.hidden=false; } else { rb.hidden=true; } }
}
function setReadiness(d){
  var r=d.readiness||{};
  var b=document.getElementById('readinessBadge'); if(b){ setBadge(b,r.ready?'ok':'err',r.state||'','chip'); b.title=r.reason||''; }
}
function setStale(on){ var b=document.getElementById('staleBanner'); if(!b) return; if(on){ b.className='show'; setText('staleMsg','Disconnected. Last successful update '+relMs(lastOkMs)+'.'); } else { b.className=''; } }

function refresh(){
  fetch('/api/status.json',{cache:'no-store'}).then(function(r){ if(!r.ok) throw new Error('status '+r.status); return r.json(); }).then(function(d){
    lastOkMs=Date.now(); setStale(false);
    lastData=d;
    setHealth(d); setReadiness(d); updateRollup(d); updateTrends(d); updateDelivery(d); rebuildCapacity(d.capacity); redrawCharts();
    if(d.service) setText('uptime', d.service.uptime);
    setText('generatedAt', d.generated_at);
    rebuildThrottle(d.tenants); rebuildTenants(d.tenants);
  }).catch(function(){ setStale(true); });
}
function startPolling(){ if(pollTimer) clearInterval(pollTimer); var ms=(window.__refreshMs>0?window.__refreshMs:5000); pollTimer=setInterval(refresh,ms); }
function togglePause(){ paused=!paused; var btn=document.getElementById('pauseBtn'); if(paused){ if(pollTimer){clearInterval(pollTimer); pollTimer=null;} if(btn) btn.textContent='Resume'; } else { if(btn) btn.textContent='Pause'; refresh(); startPolling(); } }
function tickFreshness(){ setText('updatedAgo', relMs(lastOkMs)); var b=document.getElementById('staleBanner'); if(b && b.className.indexOf('show')>=0) setStale(true); }

function initCharts(){
  registerChart('chGoroutines', function(d){ return d&&d.runtime ? [{name:'goroutines', points:d.runtime.goroutines_series||[]}] : []; });
  registerChart('chHeap', function(d){ return d&&d.runtime ? [{name:'heap', points:(d.runtime.heap_alloc_series||[]).map(function(b){ return b/1048576; })}] : []; }, function(v){ return v.toFixed(0)+'M'; });
  registerChart('chGC', function(d){ return d&&d.runtime ? [{name:'gc/s', points:d.runtime.gc_rate_series||[]}] : []; }, function(v){ return v.toFixed(1); });
  registerChart('chEmit', function(d){ return d&&d.throughput ? [
    {name:'metrics/s', points:d.throughput.metric_points_series||[]},
    {name:'logs/s', points:d.throughput.log_records_series||[]}] : []; }, function(v){ return v.toFixed(1); });
  registerChart('chCard', function(d){ if(!d) return []; var s=d.cardinality&&d.cardinality.series; return (s&&s.length) ? [{name:'series', points:s}] : null; }, null, 'none yet, or self-observability off');
  registerChart('chFailing', function(d){ return d&&d.fleet ? [{name:'failing', points:d.fleet.failing_series||[]}] : []; });
  registerChart('chDuration', function(d){ return d&&d.fleet ? [{name:'mean', points:d.fleet.mean_duration_series||[]}] : []; }, function(v){ return v.toFixed(0)+'ms'; });
}

(function init(){
  initTabs(); initCharts(); applyFilter();
  var tt=document.getElementById('themeToggle'); if(tt) tt.addEventListener('click',toggleTheme);
  var p=document.getElementById('pauseBtn'); if(p) p.addEventListener('click',togglePause);
  var rn=document.getElementById('refreshNow'); if(rn) rn.addEventListener('click',function(ev){ ev.preventDefault(); refresh(); });
  var rt=document.getElementById('retryNow'); if(rt) rt.addEventListener('click',function(){ refresh(); });
  refresh(); startPolling(); setInterval(tickFreshness,1000);
  window.addEventListener('resize',redrawCharts);
})();
</script>
</body>
</html>
